#using scripts\zm\zm_tod2_cybercity\_tod_keeper;          // keeper_blackboard / keeper_zombie_flags: the archetype's setup (same skeleton, same tree)
#using scripts\zm\zm_tod2_cybercity\_tod_bosses;          // grant_elite_reward (the killer's purse); boss_player_damage reads tod_keeper_dmg
#using scripts\zm\zm_tod2_cybercity\_tod_luck;            // boss_kill (luck + the kill confirm)
#using scripts\zm\zm_tod2_cybercity\_tod_perk_scatter;    // play_sound_at_origin (the proven 3D lane)

#insert scripts\shared\shared.gsh;
#insert scripts\shared\version.gsh;

#precache( "model", "tod_dealer_body" );
#precache( "model", "tod_dealer_body_cracked" );
#precache( "model", "tod_dealer_scythe" );
#precache( "model", "tod_dealer_lmg" );
#precache( "model", "tod_dealer_dg2" );
#precache( "fx", "tod/dealer/fx_tod_dealer_aura" );
#precache( "fx", "tod/dealer/fx_tod_dealer_aura_cracked" );
#precache( "fx", "tod/dealer/fx_tod_dealer_aura_trail" );
#precache( "fx", "tod/dealer/fx_tod_dealer_arrive" );
#precache( "fx", "tod/dealer/fx_tod_dealer_mask_shatter" );
#precache( "fx", "tod/dealer/fx_tod_dealer_eye_die" );
#precache( "fx", "tod/dealer/fx_tod_dealer_death" );
#precache( "fx", "tod/dealer/fx_tod_dealer_dissolve" );

#define TOD_DEALER_SPAWNER        "spawner_tod_dealer"
#define TOD_DEALER_HP_ZOMBIES     60      // his health in round-zombie units, per playing player (a first number: the fight's ladder is docs/dealer_finale_design.md)
#define TOD_DEALER_MASK_CRACK     0.5     // the health fraction where the mask CRACKS (user: "at half health")
#define TOD_DEALER_MELEE_MULT     1.25    // his swipe on players (the Keeper's rate; _tod_bosses::boss_player_damage reads the field)
#define TOD_DEALER_TEAM_PTS       2000    // every playing player, on top of the killer's elite purse
#define TOD_DEALER_PORTAL_SECS    1.3     // the rift's float-in before he thinks (fx_tod_dealer_arrive is timed to it)
#define TOD_DEALER_TICK           0.25
#define TOD_DEALER_STUCK_SECS     20      // not moved for this long with nobody near -> log (no relocation yet)
#define TOD_DEALER_CORPSE_SECS    6
// HIS LOOK AND HIS SOUND (W2B): the effects (LOCKSTEP tools/dealer_fx/gen_fx.py EFFECTS + the zone's fx lines) and the sounds
// (LOCKSTEP tools/dealer_sfx/make_sounds.py CUES -> sound/aliases/tod_dealer.csv)
#define TOD_DEALER_FX_AURA        "tod/dealer/fx_tod_dealer_aura"           // state one's black shadow (j_spine4)
#define TOD_DEALER_FX_AURA_CRACK  "tod/dealer/fx_tod_dealer_aura_cracked"   // state two's, hotter, one small light
#define TOD_DEALER_FX_TRAIL       "tod/dealer/fx_tod_dealer_aura_trail"     // the black mist at his feet (tag_origin)
#define TOD_DEALER_FX_ARRIVE      "tod/dealer/fx_tod_dealer_arrive"
#define TOD_DEALER_FX_SHATTER     "tod/dealer/fx_tod_dealer_mask_shatter"   // at the face (tag_eye: +X out of it)
#define TOD_DEALER_FX_EYE_DIE     "tod/dealer/fx_tod_dealer_eye_die"        // at the right socket
#define TOD_DEALER_FX_DEATH       "tod/dealer/fx_tod_dealer_death"          // at the floor under him
#define TOD_DEALER_FX_DISSOLVE    "tod/dealer/fx_tod_dealer_dissolve"       // on the corpse, the last seconds
#define TOD_DEALER_SND_SPAWN      "tod_dealer_spawn"
#define TOD_DEALER_SND_CRACK      "tod_dealer_mask_crack"
#define TOD_DEALER_SND_DEATH      "tod_dealer_death"
#define TOD_DEALER_SND_HIT        "tod_dealer_scythe_hit"       // a blow of his that LANDS (dealer_hit_cb): state one, the blade
#define TOD_DEALER_SND_HIT_BASH   "tod_dealer_bash_hit"         // ... state two: the gun's stock driven in like a club (blunt)
#define TOD_DEALER_SND_HUM        "tod_dealer_levitate_lp"      // state one's levitation (3D LOOPING on him; stopped at the crack / death)
#define TOD_DEALER_HUM_FADE       0.6
#define TOD_DEALER_HIT_GAP_MS     150     // one ring per blow (a sweep that catches two players rings once)
#define TOD_DEALER_FX_REPLICATE   0.1     // a fresh carrier replicates for two frames before its effect plays
#define TOD_DEALER_FX_POLL        0.25    // a carrier whose actor is gone deletes itself within this (the failsafe)
#define TOD_DEALER_SHATTER_SECS   3.0     // the crack's carriers live this long (the shards land, the eye's last spit at 1.5 s)
#define TOD_DEALER_ARRIVE_SECS    3.0     // the arrival carrier (the rift's column thins by ~2.7 s)
#define TOD_DEALER_DEATH_FX_SECS  3.2
#define TOD_DEALER_DISSOLVE_SECS  2.0     // LOCKSTEP tools/dealer_fx/gen_fx.py DISSOLVE_DELETE_MS: the corpse is deleted under the last billow
#define TOD_DEALER_DISSOLVE_TAIL  1.6     // the dissolve carrier outlives the corpse by this (the billow and the ash finish)
#define TOD_DEALER_FX_LOG_MAX     40      // FX log lines per match (a long fight never floods the console)
#define TOD_DEALER_HIT_LOG_MAX    12      // HIT lines per match (the first dozen landed blows prove the ring)
#define TOD_DEALER_LOG            1       // prints with dev OFF for the user's playtest; ZERO before a publish
// TEST (user 2026-10-01: "spawn him in the crown so i can test"): he spawns in the crown hall after the opening
// cards. 0 before a publish (build_map.ps1 refuses -Publish while it is 1).
#define TOD_DEALER_TEST_SPAWN     0       // 0 since docs/207: THE DEALER'S HOUSE is his place (the crown-hall test spawn is history)
#define TOD_DEALER_TEST_DELAY     6       // seconds after the round-1 card deal (the players are out of the menus)
#define TOD_DEALER_TEST_WAIT_MAX  90      // if no deal ever reports (a dev state), spawn him anyway after this

#using_animtree( "generic" );

#precache( "fx", "tod/dealer_combat/fx_dc_warning" );
#precache( "fx", "tod/dealer_combat/fx_dc_charge" );
#precache( "fx", "tod/dealer_combat/fx_dc_shock" );
#precache( "fx", "tod/dealer_combat/fx_dc_muzzle" );
#precache( "fx", "tod/dealer_combat/fx_dc_tracer" );

#define TOD_DC_OPENING_GRACE  6.0
#define TOD_DC_POLL           0.05
#define TOD_DC_RANGE          2800
#define TOD_DC_TARGET_MAX     4
#define TOD_DC_RADIUS         100
#define TOD_DC_HEIGHT         90
#define TOD_DC_SHOT_RADIUS    24
#define TOD_DC_SHOCK_TELL     1.8
#define TOD_DC_BURST_TELL     1.3
#define TOD_DC_SHOCK_GAP      8.0
#define TOD_DC_BURST_GAP      5.0
#define TOD_DC_RECOVERY       0.65
#define TOD_DC_SHOCK_LIFE     0.45
#define TOD_DC_SHOCK_DAMAGE   30
#define TOD_DC_SHOT_DAMAGE    8
#define TOD_DC_BURST_SHOTS    6
#define TOD_DC_SHOT_GAP       0.25
#define TOD_DC_SHOT_TRAVEL    0.10
#define TOD_DC_FX_WARNING     "tod/dealer_combat/fx_dc_warning"
#define TOD_DC_FX_CHARGE      "tod/dealer_combat/fx_dc_charge"
#define TOD_DC_FX_SHOCK       "tod/dealer_combat/fx_dc_shock"
#define TOD_DC_FX_MUZZLE      "tod/dealer_combat/fx_dc_muzzle"
#define TOD_DC_FX_TRACER      "tod/dealer_combat/fx_dc_tracer"
#define TOD_DC_SND_WARNING    "tod_dc_warning"
#define TOD_DC_SND_BURST_TELL "tod_dc_burst_tell"
#define TOD_DC_SND_SHOCK      "tod_dc_shock"
#define TOD_DC_SND_SHOT       "tod_dc_shot"
#define TOD_DC_LMG_MUZZLE (23.125085830688477, 0.0, 3.873854398727417)

#namespace tod_dealer_finale;

REGISTER_SYSTEM( "tod_dealer_finale", &__init__, undefined )

// The tree's one custom function and the archetype's spawn functions must exist
// before the first Dealer spawns: a system's __init__ (memory
// clientfield-register-in-system-init). The archetype "dealer" gets the Keeper's
// own blackboard (arms position, locomotion speed, variant, ...) and zombie flags:
// same skeleton, same behavior tree, same services.
function __init__()
{
	BehaviorTreeNetworkUtility::RegisterBehaviorTreeScriptAPI( "dealerDeathStart", &death_start );
	spawner::add_archetype_spawn_function( "dealer", &tod_keeper::keeper_blackboard );
	spawner::add_archetype_spawn_function( "dealer", &tod_keeper::keeper_zombie_flags );
}

function dev_log( msg )
{
	if ( !( IS_TRUE( level.tod_dev ) || IS_TRUE( level.tod_diag ) ) && !TOD_DEALER_LOG )
		return;
	line = "[TOD_DEALER] ms=" + GetTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}

function init()
{
	level.tod_dealer_gen = 0;
	level.tod_dealer_live = undefined;
	level.tod_dealer_fx_logs = 0;
	// a blow of his that LANDS rings on the player it hit (read-only: it never changes the damage; first in the chain so
	// no listener that answers before it can swallow the ring)
	if ( !isdefined( level.player_damage_callbacks ) )
		level.player_damage_callbacks = [];
	ArrayInsert( level.player_damage_callbacks, &dealer_hit_cb, 0 );
	dev_log( "INIT rev=3 spawner=" + TOD_DEALER_SPAWNER + " hp_zombies=" + TOD_DEALER_HP_ZOMBIES + " mask_crack=" + TOD_DEALER_MASK_CRACK
		+ " melee=x" + TOD_DEALER_MELEE_MULT + " test_spawn=" + TOD_DEALER_TEST_SPAWN );
	if ( TOD_DEALER_TEST_SPAWN )
		level thread test_spawn();
}

// ---------------------------------------------------------------------------
// THE TEST SPAWN (TOD_DEALER_TEST_SPAWN): the crown hall, after the opening
// ---------------------------------------------------------------------------
function test_spawn()
{
	level endon( "end_game" );
	level flag::wait_till( "initial_blackscreen_passed" );
	// the opening = the class draft, then the round-1 card deal: never spawn him into a menu
	what = level util::waittill_any_timeout( TOD_DEALER_TEST_WAIT_MAX, "tod_upg_event_over" );
	wait TOD_DEALER_TEST_DELAY;
	center = tod_crown_data::hall_center();
	org = center + ( 0, -448, 0 );   // between the gate and the alarm button, on the hall's axis (the four pillars sit at x +-448)
	target = ArrayGetClosest( org, GetPlayers() );
	actor = spawn_boss( org, target );
	dev_log( "TEST_SPAWN after=" + what + " result=" + ( isdefined( actor ) ? "ok" : "failed" ) + " at=" + org );
}

// ---------------------------------------------------------------------------
// THE BOSS
// ---------------------------------------------------------------------------

// his health: round-zombie units x the playing party (the same units every hit is in - _tod_power_scale)
function dealer_hp()
{
	unit = level.zombie_health;
	if ( !isdefined( unit ) || unit < 1 )
		unit = 150;
	n = 0;
	foreach ( p in GetPlayers() )
		if ( isdefined( p ) && p.sessionstate == "playing" )
			n++;
	if ( n < 1 )
		n = 1;
	return int( unit * TOD_DEALER_HP_ZOMBIES * n );
}

// PUBLIC. Spawns him at org facing target. Returns the actor or undefined.
function spawn_boss( org, target )
{
	if ( isdefined( level.tod_dealer_live ) && IsAlive( level.tod_dealer_live ) )
	{
		dev_log( "SPAWN_FAILED reason=already_live ent=" + level.tod_dealer_live GetEntityNumber() );
		return undefined;
	}
	if ( GetFreeActorCount() < 1 )
	{
		dev_log( "SPAWN_FAILED reason=actor_pool free=" + GetFreeActorCount() );
		return undefined;
	}
	yaw = 90;
	if ( isdefined( target ) )
	{
		face = VectorToAngles( target.origin - org );
		yaw = face[ 1 ];
	}
	// THE ARRIVAL: the rift tears up through the spot (+Z up: angles yaw only) and swallows the moment he appears
	rift = fx_carrier( TOD_DEALER_FX_ARRIVE, org, ( 0, yaw, 0 ), TOD_DEALER_ARRIVE_SECS );
	actor = SpawnActor( TOD_DEALER_SPAWNER, org, ( 0, yaw, 0 ), "tod_dealer", true );
	if ( !isdefined( actor ) )
	{
		// no rift and no tear without him: the house retries every 2 s, and an empty rift each time would read as a bug
		// (the carrier is still inside its replicate wait, so its effect never plays)
		if ( isdefined( rift ) )
			rift Delete();
		dev_log( "SPAWN_FAILED reason=spawn_actor spawner=" + TOD_DEALER_SPAWNER + " at=" + org + " rift=withdrawn" );
		return undefined;
	}
	tod_perk_scatter::play_sound_at_origin( org + ( 0, 0, 40 ), TOD_DEALER_SND_SPAWN, 4 );
	level.tod_dealer_gen++;
	actor.tod_dealer = true;
	actor.tod_dealer_gen = level.tod_dealer_gen;
	actor.tod_dealer_state = 1;
	actor.tod_dealer_attack_serial = 0;
	actor.tod_dealer_attacking = false;
	actor.tod_boss_kind = "dealer";
	actor.is_boss = true;
	actor.acc_is_boss = true;
	actor.tod_boss_custom_speed = true;
	actor.acc_boss_custom_speed = true;
	actor.ignore_enemy_count = true;
	actor.ignore_round_spawn_failsafe = true;
	actor.no_powerups = true;
	actor.disableAmmoDrop = true;
	actor.ignore_nuke = true;
	actor.no_gib = true;
	actor.team = level.zombie_team;
	actor.spawn_time = GetTime();
	hp = dealer_hp();
	actor.health = hp;
	actor.maxhealth = hp;
	actor.tod_keeper_dmg = TOD_DEALER_MELEE_MULT;   // _tod_bosses::boss_player_damage reads this field on any non-player attacker
	actor.zombie_move_speed = "walk";               // the calm glide (STATE ONE); the state flip runs
	actor.zombie_arms_position = "up";              // STATE ONE: the float set (idle / move / melee selectors key on it)
	actor.variant_type = 0;
	actor.favoriteenemy = target;
	actor.voiceprefix = "dealer";
	actor.animname = "dealer";
	level.tod_dealer_live = actor;
	actor weapon_set( "scythe" );
	actor aura_set( 1 );                                    // the black shadow off his coat + the mist at his feet
	actor PlayLoopSound( TOD_DEALER_SND_HUM, TOD_DEALER_HUM_FADE );   // state one floats: the hum of it
	actor thread wake();
	actor thread brain();
	actor thread combat();
	actor thread death_watch();
	dev_log( "SPAWN gen=" + actor.tod_dealer_gen + " ent=" + actor GetEntityNumber() + " hp=" + hp + " state=1 arms=up weapon=scythe at=" + org
		+ " yaw=" + int( yaw ) + " target=" + ( isdefined( target ) ? target GetEntityNumber() : -1 ) );
	return actor;
}

function delete_after( secs )
{
	wait secs;
	if ( isdefined( self ) )
		self Delete();
}

// the portal's float-in, then he thinks (the tree waits on zombie_think_done)
function wake()
{
	self endon( "death" );
	wait TOD_DEALER_PORTAL_SECS;
	self.zombie_think_done = true;
	dev_log( "READY gen=" + self.tod_dealer_gen + " ent=" + self GetEntityNumber() + " hp=" + self.health );
}

// the weapon in his right hand: a rigid model on tag_weapon_right (the two-hand hold is in the clips)
function weapon_set( kind )
{
	if ( isdefined( self.tod_dealer_weapon ) )
	{
		self Detach( self.tod_dealer_weapon, "tag_weapon_right" );
		self.tod_dealer_weapon = undefined;
	}
	model = undefined;
	switch ( kind )
	{
		case "scythe": model = "tod_dealer_scythe"; break;
		case "lmg":    model = "tod_dealer_lmg";    break;
		case "dg2":    model = "tod_dealer_dg2";    break;
	}
	if ( isdefined( model ) )
	{
		self Attach( model, "tag_weapon_right" );
		self.tod_dealer_weapon = model;
	}
	dev_log( "WEAPON gen=" + self.tod_dealer_gen + " kind=" + kind + " model=" + ( isdefined( model ) ? model : "none" ) );
}

// THE MASK CRACKS (TOD_DEALER_MASK_CRACK): STATE TWO - the same Dealer, the cracked mask (one eye dead, the
// grin torn wider), on the ground with the machine gun. The cracked body is the same bake with the other mask's
// faces; the moment is sold at the FACE (W2B): the mask shatters off tag_eye, the right eye's wire sputters out at
// its socket, the shadow turns hot red, the levitation hum dies (he is on his feet now), the crack and its shriek.
function mask_crack()
{
	self dc_cancel( "phase" );
	self.tod_dealer_state = 2;
	self weapon_set( "none" );                      // detach first: the body swap must not strand an attachment
	self SetModel( "tod_dealer_body_cracked" );
	self.zombie_arms_position = "down";             // the ground set (idle / move / melee / death selectors)
	self.zombie_move_speed = "run";
	self weapon_set( "lmg" );
	self fx_linked( TOD_DEALER_FX_SHATTER, "tag_eye", ( 1, 0, 0 ), TOD_DEALER_SHATTER_SECS );            // the mask breaks at the face
	self fx_linked( TOD_DEALER_FX_EYE_DIE, "tag_eye", ( 0.6, -2.3, 0.4 ), TOD_DEALER_SHATTER_SECS );     // the right eye (+Y is his left)
	self aura_set( 2 );
	self StopLoopSound( TOD_DEALER_HUM_FADE );
	tod_perk_scatter::play_sound_at_origin( self tag_point( "tag_eye", 70 ), TOD_DEALER_SND_CRACK, 4 );
	dev_log( "STATE gen=" + self.tod_dealer_gen + " state=2 why=mask_crack hp=" + self.health + "/" + self.maxhealth + " arms=down weapon=lmg model=tod_dealer_body_cracked" );
	if ( isdefined( level.tod_dealer_crack_fn ) )
		level thread [[ level.tod_dealer_crack_fn ]]( self );   // docs/207: his word at the crack
}

function brain()
{
	self endon( "death" );
	level endon( "end_game" );
	last_org = self.origin;
	still = 0;
	was_paused = false;
	was_held = false;
	last_pct = 100;
	while ( true )
	{
		wait TOD_DEALER_TICK;
		// THE FREEZE under a card deal (the elites' own rule: every tick, never only the edge)
		if ( IS_TRUE( level.tod_upgrade_pause ) )
		{
			if ( !was_paused )
				dev_log( "FREEZE gen=" + self.tod_dealer_gen + " value=1" );
			self.ignoreall = true;
			self ASMSetAnimationRate( 0.05 );
			was_paused = true;
			continue;
		}
		if ( was_paused )
		{
			self.ignoreall = ( IS_TRUE( level.tod_dealer_hold ) || IS_TRUE( self.tod_dealer_attacking ) || ( self dc_disabled() ) );
			self ASMSetAnimationRate( 1.0 );
			was_paused = false;
			dev_log( "FREEZE gen=" + self.tod_dealer_gen + " value=0" );
		}
		// THE DEALER'S HOUSE (docs/207): held while he talks - he stands and waits, nobody is prey yet
		if ( IS_TRUE( level.tod_dealer_hold ) )
		{
			if ( !was_held )
				dev_log( "HOLD gen=" + self.tod_dealer_gen + " value=1" );
			self.ignoreall = true;
			was_held = true;
			continue;
		}
		if ( was_held )
		{
			self.ignoreall = ( IS_TRUE( level.tod_upgrade_pause ) || IS_TRUE( self.tod_dealer_attacking ) || ( self dc_disabled() ) );
			was_held = false;
			dev_log( "HOLD gen=" + self.tod_dealer_gen + " value=0" );
		}
		// HEALTH: a line every tenth lost, and the mask crack at its fraction
		pct = int( 100 * self.health / self.maxhealth );
		if ( pct <= last_pct - 10 )
		{
			last_pct = pct - ( pct % 10 );
			dev_log( "HP gen=" + self.tod_dealer_gen + " pct=" + pct + " hp=" + self.health + "/" + self.maxhealth + " state=" + self.tod_dealer_state );
		}
		if ( self.tod_dealer_state == 1 && self.health <= self.maxhealth * TOD_DEALER_MASK_CRACK )
			self mask_crack();
		if ( IS_TRUE( self.tod_dealer_attacking ) || ( self dc_disabled() ) ) continue;
		// STUCK: not moved for TOD_DEALER_STUCK_SECS while nobody is close -> log it (the relocation is the fight's)
		if ( DistanceSquared( self.origin, last_org ) > 64 * 64 )
		{
			last_org = self.origin;
			still = 0;
		}
		else
		{
			still += TOD_DEALER_TICK;
			near = false;
			foreach ( p in GetPlayers() )
				if ( isdefined( p ) && p.sessionstate == "playing" && DistanceSquared( p.origin, self.origin ) < 300 * 300 )
					near = true;
			if ( near )
				still = 0;
			if ( still >= TOD_DEALER_STUCK_SECS )
			{
				dev_log( "STUCK gen=" + self.tod_dealer_gen + " secs=" + still + " at=" + self.origin + " speed=" + self.zombie_move_speed + " state=" + self.tod_dealer_state );
				still = 0;
			}
		}
	}
}

// the tree's death StartFunction (registered as dealerDeathStart): the body stays for the ground death clip
function death_start( entity )
{
	entity NotSolid();
	dev_log( "DEATH_START gen=" + entity.tod_dealer_gen + " ent=" + entity GetEntityNumber() + " state=" + entity.tod_dealer_state );
}

function death_watch()
{
	gen = self.tod_dealer_gen;
	self waittill( "death", attacker );
	org = ( isdefined( self ) ? self.origin : undefined );
	if ( isdefined( self ) )
	{
		self dc_cancel( "death" );
		// THE BURST before the reward: the shadow lets go of him, the hum stops, the mask's last shards, the soul column
		self aura_set( 0 );
		self StopLoopSound( 0.2 );
		fx_carrier( TOD_DEALER_FX_DEATH, org, ( 0, self.angles[ 1 ], 0 ), TOD_DEALER_DEATH_FX_SECS );
	}
	if ( isdefined( org ) )
		tod_perk_scatter::play_sound_at_origin( org + ( 0, 0, 50 ), TOD_DEALER_SND_DEATH, 5 );
	if ( isdefined( attacker ) && IsPlayer( attacker ) )
		tod_luck::boss_kill( attacker, "dealer" );
	tod_bosses::grant_elite_reward( "DEALER", attacker, org );
	n = 0;
	foreach ( p in GetPlayers() )
		if ( isdefined( p ) && p.sessionstate == "playing" )
		{
			p zm_score::add_to_player_score( TOD_DEALER_TEAM_PTS );
			n++;
		}
	if ( isdefined( level.tod_dealer_live ) && level.tod_dealer_live == self )
		level.tod_dealer_live = undefined;
	dev_log( "DEATH gen=" + gen + " killer=" + ( ( isdefined( attacker ) && IsPlayer( attacker ) ) ? attacker GetEntityNumber() : -1 )
		+ " state=" + ( isdefined( self ) ? self.tod_dealer_state : -1 ) + " team_paid=" + n + "x" + TOD_DEALER_TEAM_PTS );
	if ( isdefined( level.tod_dealer_death_fn ) )
		level thread [[ level.tod_dealer_death_fn ]]( self );   // docs/207: his last word
	if ( isdefined( self ) )
		self thread corpse_cleanup();
}

// the body stays for the ground death clip, then BURNS AWAY: the dissolve starts TOD_DEALER_DISSOLVE_SECS before the delete
// and its last black billow swallows the body as it goes (W2B; it used to blink out of existence)
function corpse_cleanup()
{
	gen = self.tod_dealer_gen;
	wait ( TOD_DEALER_CORPSE_SECS - TOD_DEALER_DISSOLVE_SECS );
	if ( !isdefined( self ) )
	{
		dev_log( "CORPSE_GONE gen=" + gen + " before_dissolve=1" );
		return;
	}
	at = self tag_point( "j_spine4", 24 );
	fx_carrier( TOD_DEALER_FX_DISSOLVE, at, ( 0, 0, 0 ), TOD_DEALER_DISSOLVE_SECS + TOD_DEALER_DISSOLVE_TAIL );
	dev_log( "DISSOLVE gen=" + gen + " at=" + at + " delete_in=" + TOD_DEALER_DISSOLVE_SECS );
	wait TOD_DEALER_DISSOLVE_SECS;
	if ( isdefined( self ) )
		self Delete();
}

// ---------------------------------------------------------------------------
// HIS LOOK (W2B / PK11): every effect on a tag_origin CARRIER
// ---------------------------------------------------------------------------
function fx_log( msg )
{
	if ( !isdefined( level.tod_dealer_fx_logs ) )
		level.tod_dealer_fx_logs = 0;
	if ( level.tod_dealer_fx_logs >= TOD_DEALER_FX_LOG_MAX )
		return;
	level.tod_dealer_fx_logs++;
	dev_log( msg );
}

// a bone's position, or a point `up` over the origin when the model has no such bone (never PlayFX on a bone we have not
// seen: memory playfxontag-missing-bone-crashes)
function tag_point( tag, up )
{
	v = self GetTagOrigin( tag );
	if ( isdefined( v ) )
		return v;
	return self.origin + ( 0, 0, up );
}

// a one-shot or looping effect at a world point on its own carrier, deleted after `life` seconds (0 = its owner deletes it)
function fx_carrier( fx, org, angles, life )
{
	host = Spawn( "script_model", org );
	if ( !isdefined( host ) )
	{
		fx_log( "FX_DROPPED effect=" + fx + " reason=entity_pool_full" );
		return undefined;
	}
	host SetModel( "tag_origin" );
	host.angles = angles;
	host thread carrier_play( fx, life, undefined );
	fx_log( "FX effect=" + fx + " at=" + org + " life=" + life );
	return host;
}

// self = the actor: an effect on a carrier LINKED to one of his bones (offset in the bone's frame); it follows him and
// deletes itself after `life` seconds, or the moment he is gone (life 0 = the owner deletes it, the failsafe still holds)
function fx_linked( fx, tag, offset, life )
{
	if ( !isdefined( self GetTagOrigin( tag ) ) )
	{
		fx_log( "FX_DROPPED effect=" + fx + " reason=no_tag tag=" + tag );
		tag = "tag_origin";
	}
	host = Spawn( "script_model", self GetTagOrigin( tag ) );
	if ( !isdefined( host ) )
	{
		fx_log( "FX_DROPPED effect=" + fx + " reason=entity_pool_full" );
		return undefined;
	}
	host SetModel( "tag_origin" );
	host LinkTo( self, tag, offset, ( 0, 0, 0 ) );
	host thread carrier_play( fx, life, self );
	fx_log( "FX effect=" + fx + " tag=" + tag + " life=" + life + " gen=" + self.tod_dealer_gen );
	return host;
}

// self = a carrier: two frames to replicate, the effect on its tag, then its life (or its owner's) runs out
function carrier_play( fx, life, owner )
{
	self endon( "death" );
	wait TOD_DEALER_FX_REPLICATE;
	PlayFXOnTag( fx, self, "tag_origin" );
	owned = isdefined( owner );
	t = 0;
	while ( life <= 0 || t < life )
	{
		if ( owned && !isdefined( owner ) )
			break;                                              // the actor is gone: never strand a looping shadow in the room
		wait TOD_DEALER_FX_POLL;
		t += TOD_DEALER_FX_POLL;
	}
	self Delete();
}

// self = the actor: his shadow for a state (1 = the scythe float, 2 = the cracked mask, 0 = none). The aura is replaced at
// the crack (the old carrier's smoke finishes as the new one starts); the mist at his feet is laid once and taken at 0.
function aura_set( state )
{
	if ( isdefined( self.tod_dealer_aura ) )
		self.tod_dealer_aura Delete();
	self.tod_dealer_aura = undefined;
	if ( state == 0 )
	{
		if ( isdefined( self.tod_dealer_trail ) )
			self.tod_dealer_trail Delete();
		self.tod_dealer_trail = undefined;
		fx_log( "AURA gen=" + self.tod_dealer_gen + " state=0 (off)" );
		return;
	}
	fx = ( state == 2 ? TOD_DEALER_FX_AURA_CRACK : TOD_DEALER_FX_AURA );
	self.tod_dealer_aura = self fx_linked( fx, "j_spine4", ( 0, 0, 0 ), 0 );
	if ( !isdefined( self.tod_dealer_trail ) )
		self.tod_dealer_trail = self fx_linked( TOD_DEALER_FX_TRAIL, "tag_origin", ( 0, 0, 2 ), 0 );
	fx_log( "AURA gen=" + self.tod_dealer_gen + " state=" + state + " aura=" + isdefined( self.tod_dealer_aura ) + " trail=" + isdefined( self.tod_dealer_trail ) );
}

// ---------------------------------------------------------------------------
// HIS BLOWS (W2B / PK10): a blow of his that lands rings on the player it hit. level.player_damage_callbacks, self = the
// player; READ-ONLY (always -1: the damage is never touched), never a wait.
// ---------------------------------------------------------------------------
function dealer_hit_cb( eInflictor, eAttacker, iDamage, iDFlags, sMeansOfDeath, weapon, vPoint, vDir, sHitLoc, psOffsetTime )
{
	if ( !isdefined( eAttacker ) || !IS_TRUE( eAttacker.tod_dealer ) || !isdefined( iDamage ) || iDamage <= 0 )
		return -1;
	if ( IS_TRUE( level.tod_house_shield ) || IS_TRUE( level.tod_upgrade_pause ) )
		return -1;                                              // nothing lands under the house's shield / a card deal
	if ( !isdefined( sMeansOfDeath ) || sMeansOfDeath != "MOD_MELEE" ) return -1;
	now = GetTime();
	if ( isdefined( level.tod_dealer_hit_ms ) && now - level.tod_dealer_hit_ms < TOD_DEALER_HIT_GAP_MS )
		return -1;
	level.tod_dealer_hit_ms = now;
	snd = TOD_DEALER_SND_HIT;                                   // the scythe's blade (state one) ...
	if ( isdefined( eAttacker.tod_dealer_state ) && eAttacker.tod_dealer_state == 2 )
		snd = TOD_DEALER_SND_HIT_BASH;                          // ... the gun's stock, blunt (state two)
	self PlaySound( snd );
	mod = ( isdefined( sMeansOfDeath ) ? sMeansOfDeath : "none" );
	if ( !isdefined( level.tod_dealer_hit_logs ) )
		level.tod_dealer_hit_logs = 0;
	level.tod_dealer_hit_logs++;
	if ( level.tod_dealer_hit_logs <= TOD_DEALER_HIT_LOG_MAX )
		dev_log( "HIT n=" + level.tod_dealer_hit_logs + " gen=" + eAttacker.tod_dealer_gen + " victim=" + self GetEntityNumber() + " dmg=" + iDamage + " mod=" + mod
		+ " state=" + eAttacker.tod_dealer_state + " snd=" + snd );
	return -1;
}

// DEALER WEAPONS: finite, warned attacks. Appended to tod_dealer_finale by land.py.
// Warning footprints remain at the original positions. No pursuit during a cast;
// cover clips both the visual shot and its damage. No attack survives a phase flip.

// PURE: generation/phase/lifetime gate, shared by every warning/release/wait.
function dc_verdict( alive, phase, expected_phase, serial, expected_serial, paused, held )
{
	if ( !alive ) return "gone";
	if ( phase != expected_phase ) return "phase";
	if ( serial != expected_serial ) return "superseded";
	if ( IS_TRUE( paused ) ) return "pause";
	if ( IS_TRUE( held ) ) return "hold";
	return "ok";
}

// PURE: shock footprint matches the 100-unit warning ring, across stair heights.
function dc_in_shock( point, center )
{
	d = point - center;
	return ( d[ 0 ] * d[ 0 ] + d[ 1 ] * d[ 1 ] <= TOD_DC_RADIUS * TOD_DC_RADIUS && Abs( d[ 2 ] ) <= TOD_DC_HEIGHT );
}

// PURE: distance to the finite, cover-clipped bullet segment. Never the infinite line.
function dc_in_shot( point, start, finish )
{
	ab = finish - start;
	ap = point - start;
	length_sq = ab[ 0 ] * ab[ 0 ] + ab[ 1 ] * ab[ 1 ] + ab[ 2 ] * ab[ 2 ];
	if ( length_sq < 1 ) return false;
	t = ( ap[ 0 ] * ab[ 0 ] + ap[ 1 ] * ab[ 1 ] + ap[ 2 ] * ab[ 2 ] ) / length_sq;
	if ( t < 0 || t > 1 ) return false;
	closest = start + ab * t;
	return ( DistanceSquared( point, closest ) <= TOD_DC_SHOT_RADIUS * TOD_DC_SHOT_RADIUS );
}

function dc_target_ok( p )
{
	if ( !isdefined( p ) || !IsPlayer( p ) || !IsAlive( p ) ) return false;
	if ( !isdefined( p.sessionstate ) || p.sessionstate != "playing" ) return false;
	if ( IS_TRUE( p.ignoreme ) || IS_TRUE( p.tod_jumppad_flying ) || IS_TRUE( p.tod_spin_locked ) ) return false;
	if ( !( zm_utility::is_player_valid( p ) ) ) return false;
	if ( DistanceSquared( p.origin, self.origin ) > TOD_DC_RANGE * TOD_DC_RANGE ) return false;
	return true;
}

function dc_status( ctx )
{
	if ( !isdefined( self ) || !IsAlive( self ) ) return "gone";
	if ( self dc_disabled() ) return "stun";
	return dc_verdict( self.health > 0, self.tod_dealer_state, ctx.phase, self.tod_dealer_attack_serial, ctx.serial,
		level.tod_upgrade_pause, level.tod_dealer_hold );
}

function dc_disabled()
{
	now = GetTime();
	return ( IS_TRUE( self.tod_frozen ) || ( isdefined( self.tod_emp_until ) && self.tod_emp_until > now )
		|| ( isdefined( self.tod_stun_until ) && self.tod_stun_until > now ) );
}

function dc_wait( ctx, secs )
{
	until = GetTime() + int( secs * 1000 );
	while ( GetTime() < until )
	{
		if ( ( self dc_status( ctx ) ) != "ok" ) return false;
		wait TOD_DC_POLL;
	}
	return ( ( self dc_status( ctx ) ) == "ok" );
}

function dc_host( ctx, effect, org, angles, life )
{
	host = fx_carrier( effect, org, angles, life );
	if ( isdefined( host ) ) ctx.hosts[ ctx.hosts.size ] = host;
	return host;
}

function dc_cleanup( ctx, why )
{
	foreach ( h in ctx.hosts )
		if ( isdefined( h ) ) h Delete();
	ctx.hosts = [];
	foreach ( p in ctx.warned )
		if ( isdefined( p ) ) p StopLocalSound( ( ctx.kind == "shock" ? TOD_DC_SND_WARNING : TOD_DC_SND_BURST_TELL ) );
	ctx.warned = [];
	if ( !isdefined( self ) ) return;
	// A death/phase edge already reclaimed the lane: this old cast cannot restore its weapon.
	if ( self.tod_dealer_attack_serial != ctx.serial ) return;
	self.tod_dealer_attacking = false;
	self.tod_dealer_attack_ctx = undefined;
	if ( IsAlive( self ) )
	{
		self StopAnimScripted();
		self.ignoreall = ( IS_TRUE( level.tod_upgrade_pause ) || IS_TRUE( level.tod_dealer_hold ) || IS_TRUE( self.tod_frozen ) || ( self dc_disabled() ) );
		self weapon_set( ( self.tod_dealer_state == 1 ? "scythe" : "lmg" ) );
	}
	dev_log( "ATTACK_END gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=" + ctx.kind + " why=" + why + " hosts=0" );
}

function dc_cancel( why )
{
	if ( isdefined( self.tod_dealer_attack_ctx ) )
		self dc_cleanup( self.tod_dealer_attack_ctx, why );
	self.tod_dealer_attack_serial++;
}

function dc_begin( kind, target )
{
	ctx = SpawnStruct();
	self.tod_dealer_attack_serial++;
	ctx.serial = self.tod_dealer_attack_serial;
	ctx.phase = self.tod_dealer_state;
	ctx.kind = kind;
	ctx.hosts = [];
	ctx.warned = [];
	self.tod_dealer_attack_ctx = ctx;
	self.tod_dealer_attacking = true;
	self.ignoreall = true;
	self ClearPath();
	self SetGoal( self.origin, true );
	face = VectorToAngles( ( target.origin[ 0 ], target.origin[ 1 ], self.origin[ 2 ] ) - self.origin );
	self weapon_set( ( kind == "shock" ? "dg2" : "lmg" ) );
	clip = %tod_dealer_c_shock;
	if ( kind == "burst" ) clip = %tod_dealer_c_burst;
	self AnimScripted( "note_notify", self.origin, face, clip, "normal", undefined, 1.0, 0.1 );
	dev_log( "ATTACK_BEGIN gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=" + kind + " phase=" + ctx.phase + " target=" + target GetEntityNumber() );
	return ctx;
}

function dc_visible( from, to, p )
{
	trace = BulletTrace( from, to, false, self );
	return ( trace[ "fraction" ] == 1 );
}

function dc_damage( p, dmg, kind, at )
{
	if ( !( self dc_target_ok( p ) ) || IS_TRUE( level.tod_house_shield ) || IS_TRUE( level.tod_upgrade_pause ) || IS_TRUE( level.tod_dealer_hold ) ) return;
	mod = ( kind == "shock" ? "MOD_ELECTROCUTED" : "MOD_RIFLE_BULLET" );
	p DoDamage( dmg, at, self, self, undefined, mod, 0 );
	dev_log( "ATTACK_HIT gen=" + self.tod_dealer_gen + " kind=" + kind + " victim=" + p GetEntityNumber() + " damage=" + dmg );
}

// The donor's tag_flash in attached-model coordinates, measured by 18_combat_clips.py.
// BO3's AnglesToRight is -Y in model space (the native tag-offset convention).
function dc_muzzle()
{
	ang = self GetTagAngles( "tag_weapon_right" );
	off = TOD_DC_LMG_MUZZLE;
	base = self GetTagOrigin( "tag_weapon_right" );
	muzzle = ( base + AnglesToForward( ang ) * off[ 0 ]
		- AnglesToRight( ang ) * off[ 1 ] + AnglesToUp( ang ) * off[ 2 ] );
	barrel = BulletTrace( self.origin + ( 0, 0, 40 ), muzzle, false, self );
	if ( barrel[ "fraction" ] < 1 ) return undefined; // Never fire from the far side of cover.
	return muzzle;
}

function dc_shock( target )
{
	ctx = self dc_begin( "shock", target );
	points = [];
	// Lock at most four positions, once. Never track a player after showing the warning.
	foreach ( p in GetPlayers() )
	{
		if ( points.size >= TOD_DC_TARGET_MAX ) break;
		if ( !( self dc_target_ok( p ) ) ) continue;
		floor = BulletTrace( p.origin + ( 0, 0, 12 ), p.origin - ( 0, 0, 150 ), false, p );
		if ( floor[ "fraction" ] >= 1 ) continue;
		point = floor[ "position" ] + ( 0, 0, 3 );
		host = self dc_host( ctx, TOD_DC_FX_WARNING, point, ( 0, 0, 0 ), TOD_DC_SHOCK_TELL + 0.2 );
		if ( isdefined( host ) ) points[ points.size ] = point;
	}
	if ( points.size == 0 )
	{
		self dc_cleanup( ctx, "no_warning" );
		return;
	}
	coil = self dc_host( ctx, TOD_DC_FX_CHARGE, self tag_point( "tag_weapon_right", 60 ), self.angles, TOD_DC_SHOCK_TELL + 0.2 );
	if ( isdefined( coil ) ) coil LinkTo( self, "tag_weapon_right", ( 35, 0, 3 ), ( 0, 0, 0 ) );
	foreach ( p in GetPlayers() )
		if ( self dc_target_ok( p ) )
		{
			p PlaySoundToPlayer( TOD_DC_SND_WARNING, p );
			ctx.warned[ ctx.warned.size ] = p;
		}
	dev_log( "ATTACK_TELL gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=shock marks=" + points.size + " seconds=" + TOD_DC_SHOCK_TELL + " radius=" + TOD_DC_RADIUS );
	if ( !( self dc_wait( ctx, TOD_DC_SHOCK_TELL ) ) )
	{
		self dc_cleanup( ctx, self dc_status( ctx ) );
		return;
	}
	foreach ( h in ctx.hosts ) if ( isdefined( h ) ) h Delete();
	ctx.hosts = [];
	impacts = [];
	foreach ( point in points )
	{
		impact = self dc_host( ctx, TOD_DC_FX_SHOCK, point, ( 0, 0, 0 ), TOD_DC_SHOCK_LIFE );
		if ( !isdefined( impact ) ) continue;
		impacts[ impacts.size ] = point;
	}
	// Give the impact hosts their two replication frames; damage meets the visible discharge.
	if ( self dc_wait( ctx, TOD_DEALER_FX_REPLICATE ) )
	{
		// One weapon report, including co-op. Overlapping marks must not stack four identical cues.
		if ( impacts.size > 0 ) tod_perk_scatter::play_sound_at_origin( self tag_point( "tag_weapon_right", 60 ), TOD_DC_SND_SHOCK, 2 );
		foreach ( p in GetPlayers() )
		{
			if ( !( self dc_target_ok( p ) ) ) continue;
			foreach ( point in impacts )
			{
				if ( dc_in_shock( p.origin, point ) && self dc_visible( point + ( 0, 0, 20 ), p.origin + ( 0, 0, 35 ), p ) )
				{
					self dc_damage( p, TOD_DC_SHOCK_DAMAGE, "shock", point );
					break; // Overlapping co-op circles never multiply a player's shock damage.
				}
			}
		}
		dev_log( "ATTACK_FIRE gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=shock marks=" + points.size );
		self dc_wait( ctx, TOD_DC_RECOVERY );
	}
	why = self dc_status( ctx );
	self dc_cleanup( ctx, ( why == "ok" ? "complete" : why ) );
}

function dc_burst( target )
{
	ctx = self dc_begin( "burst", target );
	// The locked point, not a homing burst. A red danger ring and distinct audible rack precede it.
	aim = target.origin + ( 0, 0, 40 );
	center = target.origin + ( 0, 0, 3 );
	mark = self dc_host( ctx, TOD_DC_FX_WARNING, center, ( 0, 0, 0 ), TOD_DC_BURST_TELL + TOD_DC_BURST_SHOTS * TOD_DC_SHOT_GAP + 0.2 );
	if ( !isdefined( mark ) ) { self dc_cleanup( ctx, "no_warning" ); return; }
	foreach ( p in GetPlayers() )
		if ( self dc_target_ok( p ) )
		{
			p PlaySoundToPlayer( TOD_DC_SND_BURST_TELL, p );
			ctx.warned[ ctx.warned.size ] = p;
		}
	dev_log( "ATTACK_TELL gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=burst seconds=" + TOD_DC_BURST_TELL + " aim=" + aim );
	if ( !( self dc_wait( ctx, TOD_DC_BURST_TELL ) ) )
	{
		self dc_cleanup( ctx, self dc_status( ctx ) );
		return;
	}
	for ( shot = 0; shot < TOD_DC_BURST_SHOTS; shot++ )
	{
		if ( ( self dc_status( ctx ) ) != "ok" || !( self dc_target_ok( target ) ) ) break;
		muzzle = self dc_muzzle();
		if ( !isdefined( muzzle ) ) break;
		trace = BulletTrace( muzzle, aim, false, self );
		end = trace[ "position" ];
		self dc_host( ctx, TOD_DC_FX_MUZZLE, muzzle, VectorToAngles( end - muzzle ), 0.22 );
		bullet = self dc_host( ctx, TOD_DC_FX_TRACER, muzzle, VectorToAngles( end - muzzle ), 0.30 );
		if ( !isdefined( bullet ) ) break; // No invisible hit when the carrier pool is exhausted.
		if ( !( self dc_wait( ctx, TOD_DEALER_FX_REPLICATE ) ) ) break;
		tod_perk_scatter::play_sound_at_origin( muzzle, TOD_DC_SND_SHOT, 1 );
		if ( isdefined( bullet ) ) bullet MoveTo( end, TOD_DC_SHOT_TRAVEL );
		if ( !( self dc_wait( ctx, TOD_DC_SHOT_TRAVEL ) ) ) break;
		foreach ( p in GetPlayers() )
		{
			if ( !( self dc_target_ok( p ) ) ) continue;
			point = p.origin + ( 0, 0, 40 );
			if ( dc_in_shock( p.origin, center ) && dc_in_shot( point, muzzle, end ) && self dc_visible( muzzle, point, p ) )
				self dc_damage( p, TOD_DC_SHOT_DAMAGE, "burst", point );
		}
		self dc_wait( ctx, TOD_DC_SHOT_GAP - TOD_DEALER_FX_REPLICATE - TOD_DC_SHOT_TRAVEL );
	}
	dev_log( "ATTACK_FIRE gen=" + self.tod_dealer_gen + " op=" + ctx.serial + " kind=burst shots=" + shot );
	self dc_wait( ctx, TOD_DC_RECOVERY );
	why = self dc_status( ctx );
	self dc_cleanup( ctx, ( why == "ok" ? "complete" : why ) );
}

function combat()
{
	level endon( "end_game" );
	next = GetTime() + int( TOD_DC_OPENING_GRACE * 1000 );
	held_before = false;
	pick = 0;
	while ( isdefined( self ) && IsAlive( self ) )
	{
		wait TOD_DC_POLL;
		if ( !isdefined( self ) || !IsAlive( self ) ) break;
		blocked = ( IS_TRUE( level.tod_upgrade_pause ) || IS_TRUE( level.tod_dealer_hold ) || ( self dc_disabled() ) );
		if ( blocked ) { held_before = true; continue; }
		if ( held_before )
		{
			next = GetTime() + int( TOD_DC_OPENING_GRACE * 1000 );
			held_before = false;
		}
		if ( GetTime() < next ) continue;
		players = [];
		foreach ( p in GetPlayers() )
			if ( self dc_target_ok( p ) ) players[ players.size ] = p;
		if ( players.size == 0 ) continue;
		target = players[ pick % players.size ];
		pick++;
		if ( self.tod_dealer_state == 1 ) self dc_shock( target );
		else self dc_burst( target );
		if ( !isdefined( self ) || !IsAlive( self ) ) break;
		next = GetTime() + int( ( self.tod_dealer_state == 1 ? TOD_DC_SHOCK_GAP : TOD_DC_BURST_GAP ) * 1000 );
	}
	if ( isdefined( self ) ) self dc_cancel( "combat_over" );
}
