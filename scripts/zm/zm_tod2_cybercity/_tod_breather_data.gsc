// GENERATED by tools/gen_tower_map.js — DO NOT HAND-EDIT (regen instead).
// The haven (docs/202) furniture anchors. Source of truth: tools/haven_layout.js
// in the generator, which asserts every pair of use-triggers clears by
// radius_a + radius_b + 64 at generation time — the mechanical form of the
// v10.4 rule, added after the shipped PaP/crate pair sat 174u apart with a
// 38u rim gap and players bought the wrong 5000-point thing.
// Frame: EVEN/mirrored (all four breathers). z = the lounge mid-slab top.

#namespace tod_breather_data;

// mid-slab z of each breather lounge, ascending (laps 10/20/30/40)
function breather_zs() { return array( 3648, 7488, 11328, 15168 ); }

// Shared room detection for the arrival chime and spawn-pressure relief:
// the haven hall (docs/202 v2) — the hall, its porch and its loggia. The z band
// stops under the next lap's E flight (its first tread is 204 above the hall).
function lounge_index_at( o )
{
    zs = breather_zs();
    for ( j = 0; j < zs.size; j++ )
    {
        if ( o[ 2 ] < zs[ j ] - 64 || o[ 2 ] > zs[ j ] + 160 ) continue;
        if ( o[ 0 ] >= -256 && o[ 0 ] <= 436 && o[ 1 ] >= -256 && o[ 1 ] <= 436 ) return j;
    }
    return -1;
}

// PACK-A-PUNCH — in the east loggia, facing the field
function pap_org( z ) { return ( 150.493, -126.299, z ); }
function pap_trig( z ) { return ( 138.061, -79.931, z ); }
function pap_yaw() { return 195; }

// UPGRADE STATION — in the east loggia, facing the field
function station_org( z ) { return ( 335, 92, z ); }
function station_trig( z ) { return ( 299, 92, z ); }
function station_yaw() { return 270; }

// AMMO CRATE — the loggia's north-east corner, facing the field (its collision clip in the .map is cut
// from this same origin: label "ammo crate body", lint MODEL_CLIP_COLUMNS)
function crate_org( z ) { return ( -184, 92, z ); }
function crate_yaw() { return 270; }

// THE CRATE TRIGGER RECIPE (v17.38) — read by _tod_ammo_crate::spawn_trigger for
// EVERY crate in the map (tower, crown and arena): the trigger_radius_use sits
// crate_trig_out() in FRONT of the crate origin (front = yaw + 90) with this
// radius. The generator asserts the same numbers against every other
// vendor trigger in the lounges, so they live here, once.
function crate_trig_out() { return 56; }
function crate_trig_r()   { return 72; }

// BASE AMMO CRATE — core WEST face at the base arena, ABSOLUTE coords (no
// mirror frame; the base is authored absolute). v14.3: origin lives in the
// generator (BASE_CRATE), which also cuts its "base ammo crate body" clip
// brush and asserts it clear of the lap-1 E flight — the Workshop navmesh
// report (Pinkbrotha4310 2026-08-30) is the reason this rides the no-drift
// contract instead of a hand-typed GSC literal.
function base_crate_org() { return ( -320, 0, 0 ); }
function base_crate_yaw() { return 90; }

// THE CYBERCITY SIGN (docs/208) - Nikolai's TOWER OF DOOM / CYBERCITY sign on the core WEST
// face over the base crate, ABSOLUTE coords. The origin is the sign's BACK plane centre at its
// bottom edge, 0.5 proud of the face; the generator (BASE_SIGN) asserts it clear and cuts its
// body clip + cap. _tod_base_sign.gsc reads both.
function base_sign_org() { return ( -256.5, 0, 160 ); }
function base_sign_yaw() { return 180; }

// THE RAMPAGE INDUCER (v18.99g) — the BO6 aether canister on its cyan
// pedestal against the base arena south wall, across from Quick Revive.
// _tod_rampage.gsc reads all three; the generator cuts the pedestal brush
// ("base inducer plinth") from the same constants and ASSERTS the trigger
// origin is outside it, because a use-trigger whose origin is inside a
// solid never prompts — which is exactly how v18.99f shipped dead.
function base_inducer_org()  { return ( -264, -516, 0 ); }
function base_inducer_trig() { return ( -264, -516, 0 ); }
function base_inducer_yaw()  { return 90; }
function base_inducer_trig_r() { return 96; }
function base_inducer_trig_lift() { return 44; }   // docs/208: in the slot over the body clip

// THE HOOP (v19.18) — the bat target cut into the core south face above the
// base upgrade station. _tod_corpse_cleanup::hoop_watch scores a flung body
// whose spine enters this box; the generator cut the recess and rim from the
// same numbers, so the target the player sees IS the volume the script tests.
// lo.y includes the rim standoff so a body entering the mouth counts.
function base_hoop_lo() { return ( -48, -272, 200 ); }
function base_hoop_hi() { return ( 48, -192, 296 ); }

// TELEPORTER — the pad at the field's centre, and where up-riders land
// (208u north of the pad, still inside the field: outside the pad's 120u gather,
// so an arrival is never swept along by the next departure — v10.4 rule)
function tp_pad_org( z ) { return ( 92, 92, z ); }
function tp_arrival_org( z ) { return ( 92, 300, z ); }

// THE HAVENS (docs/202) — the safe-zone field. Every number below is cut from
// tools/haven_layout.js, the same file that cuts the hall, the rings, the posts
// and the barrier, so the field the player sees is the volume _tod_haven.gsc tests.
function haven_center( z ) { return ( 92, 92, z ); }
function haven_radius()    { return 332; }
// v4: membership is the SPHERE (a body's chest, haven_body_up() over its origin):
// in within haven_in_r3() of the sphere's centre, out past haven_out_r3(), inside
// the z band haven_z_below() .. haven_z_above() round the floor
function haven_body_up()   { return 36; }
function haven_in_r3()     { return 326.618; }
function haven_out_r3()    { return 344.618; }
function haven_z_below()   { return 48; }
function haven_z_above()   { return 312; }
function haven_sphere_r()  { return 338.618; }
function haven_sphere_c()  { return -66.618; }
function haven_top()       { return 272; }
// the two perk pads (_tod_perk_scatter), k = 0 / 1: north-east and north-west of the pad, facing out
function haven_perk_org( k, z )
{
    if ( k == 0 ) return ( -38, -133.167, z );
    return ( -38, -133.167, z );
}
function haven_perk_yaw( k ) { if ( k == 0 ) return 60; return 60; }
function haven_perk_front( k ) { if ( k == 0 ) return ( 0.5, 0.866, 0 ); return ( 0.5, 0.866, 0 ); }
// the emitter gems on the posts' collars (the field anchors), local to the field centre
function haven_gem_offsets()
{
    a = [];
    a[ 0 ] = ( 267.792, -212.96, 132 );
    a[ 1 ] = ( 268.344, 268.344, 132 );
    a[ 2 ] = ( -262.304, 258.384, 132 );
    return a;
}
// the teddy bears that live in the havens (_tod_secret): 1 = floor 10, 2 = floor 20
function secret_bear_org( i, z ) { if ( i == 1 ) return ( -224.1, -40, z + 14 ); return ( 404.6, -228.1, z + 14 ); }
function secret_bear_yaw( i ) { if ( i == 1 ) return 90; return 180; }
// the rest stop's ambient loops (_tod_atmosphere::lounge_fx)
function haven_motes_org( z ) { return ( 336, 336, z + 260 ); }
function haven_vent_org( z )  { return ( -136, -208, z + 8 ); }
// THE GUARDIANS (docs/202 v3): where they rise (inside the field, spread round it, off
// the machines and the pad), the wake band round the heart, the floor band their banners reach
function haven_guard_spots( z )
{
    a = [];
    a[ 0 ] = ( 338.516, 206.952, z );
    a[ 1 ] = ( 162.399, 354.732, z );
    a[ 2 ] = ( 21.601, 354.732, z );
    a[ 3 ] = ( -82.838, 300.364, z );
    a[ 4 ] = ( -154.516, -22.952, z );
    a[ 5 ] = ( 54.145, -177.353, z );
    a[ 6 ] = ( 266.838, -116.364, z );
    a[ 7 ] = ( 338.516, -22.952, z );
    return a;
}
function haven_wake_r()     { return 640; }
function haven_wake_z_lo()  { return -100; }
function haven_wake_z_hi()  { return 420; }
function haven_leash_r()    { return 1100; }
function haven_leash_z_lo() { return -200; }
function haven_leash_z_hi() { return 620; }
// THE FLOOR SIGN (tweak #5): the lit floor-number card on the S wall, facing the field
function haven_sign_org( z ) { return ( 20, -235, z + 330 ); }
function haven_sign_yaw()    { return 90; }
// THE BARRIER (v4): the script_brushmodel on the field's sphere, one per haven floor
function haven_barrier_name( floor ) { return "tod_haven_barrier_" + floor; }

// THE UNDERCITY + THE WORKSHOP WINGS (docs/158). Every anchor below is cut
// from the same tables that cut the rooms (the no-drift contract):
// _tod_perk_scatter reads the Quick Revive pad, _tod_partners::stations the
// bench and part anchors (the bench collision clips are generator-cut).
function undercity_z()     { return -384; }
function vault_qr_org()    { return ( -2060, -497, -384 ); }
function terrace_qr_org()  { return ( -400, 5691, 19392 ); }
function terrace_qr_yaw()  { return 269.999; }
function terrace_qr_front(){ return ( 0, -1, 0 ); }
function vault_spawn_org() { return ( -2272, -820, -384 ); }

// PARTNER BENCHES — index = partner id (0 Civil Protector, 1 Talon, 2 R.A.P.S.,
// 3 Cerberus); yaw = the way the bench FACES (into the room, at the door).
function partner_bench_org( id )
{
	switch ( id )
	{
	case 0: return ( 0, 1429, 0 );
	case 1: return ( 1429, 380, 0 );
	case 2: return ( -536, -1429, 0 );
	case 3: return ( -1429, 480, 0 );
	}
	return ( 0, 1429, 0 );
}
function partner_bench_yaw( id )
{
	switch ( id )
	{
	case 0: return 270;
	case 1: return 180;
	case 2: return 90;
	case 3: return 0;
	}
	return 270;
}
function partner_bench_room( id )
{
	switch ( id )
	{
	case 0: return "the North Workshop";
	case 1: return "the East Workshop";
	case 2: return "the South Workshop";
	case 3: return "the West Workshop";
	}
	return "the North Workshop";
}
function partner_bench_count() { return 4; }

// PARTNER PARTS — the shelf along the Conduit's west wall, index n = id * 2 +
// part (0..7), props facing east (yaw 0) into the room, 10 above the floor.
function partner_part_org( n )
{
	return ( -2503, -400 + n * 64, -374 );
}
function partner_part_yaw( n ) { return 0; }
function partner_part_count() { return 8; }
