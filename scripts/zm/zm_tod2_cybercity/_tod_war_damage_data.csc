// the torn conduits' conductors: <model>_off at connect, <model>_on once the power wave has passed their height
function conductor_count() { return 27; }
function conductor_model( i )
{
	switch ( i )
	{
		case 0: return "tod_war_conductor_a";
		case 1: return "tod_war_conductor_b";
		case 2: return "tod_war_conductor_a";
