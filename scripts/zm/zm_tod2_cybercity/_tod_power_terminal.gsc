// =============================================================================
// _tod_power_terminal.gsc - THE GRID TERMINAL: the crown's power switch (TOD II, docs/208)
//
// Ported from map 1 (its v19.68q "THE POWER SWITCH IS NIKOLAI'S GRID TERMINAL V5" and
// v19.68u "THE POWER TERMINAL ANIMATES": user 2026-10-02 "the power has no animation
// from on to off ... Like a knob turning or a switch or power visual going up on the
// screen"). On this map the switch is _tod_fall's POWER SWITCH in the crown's enclosed
// power room (the alarm first, the power after it); this module is only its LOOK:
//
//   THE PANEL  `tod_power_terminal` - Nikolai's Grid Terminal V5: GRID CONTROL /
//              RESTART SEQUENCE REQUIRED, the tower district, the restart steps, the
//              HOLD button - 60 wide, 11 deep, 88 tall; front = model +X, origin = its
//              BACK plane. It glows in the dark room before the power, so it is the
//              thing the party walks to.
//   THE DIAL   `tod_power_dial` - the HOLD button's segmented bolt ring as its own
//              disc, at the panel-local (TOD_PDIAL_X/Y/Z, map 1's power_anim.json):
//              two turns in TOD_PDIAL_SPIN on the press, upright, then `_on`.
//   THE SCREEN the five display plates 0.35 in front, one skinOverride frame each
//              (`tod_power_screen_dark` / `_f1..f3` / `tod_power_screen` = ON): the
//              screens drop out, the RESTART GRID steps light one by one while the
//              bar fills, then POWER RESTORED / SYNC COMPLETE.
//
// _tod_fall owns the trigger, the hint and the order. It calls spawn_at() where the
// stock lever used to be spawned and boot() on the pull - which BLOCKS until the
// screen reads POWER RESTORED, so the power wave starts on that frame. A power_on
// that arrives any other way (the fallback, a dev harness) shows ON directly.
// The anchor is GENERATED (_tod_crown_data.gsc power_terminal_org/_yaw/_trig, from
// gen_tower_map.js POWER_TERM), and the generator cuts the panel's body clip.
//
// DIAGNOSTICS (tod_dev): [TOD_POWER_TERM] INIT / BOOT_START / BOOT_FRAME / BOOT_DONE /
// ON_DIRECT / FAIL.
// =============================================================================

#using scripts\shared\flag_shared;

#insert scripts\shared\shared.gsh;

#precache( "model", "tod_power_terminal" );
#precache( "model", "tod_power_screen" );
#precache( "model", "tod_power_screen_dark" );
#precache( "model", "tod_power_screen_f1" );
#precache( "model", "tod_power_screen_f2" );
#precache( "model", "tod_power_screen_f3" );
#precache( "model", "tod_power_dial" );
#precache( "model", "tod_power_dial_on" );

#namespace tod_power_terminal;

#define TOD_POWER_TERM_MODEL     "tod_power_terminal"
#define TOD_POWER_TERM_REVISION  "tod2_power_anim_1"   // map 1's fan_props_4 + power_anim_1, ported (docs/208)
// THE DIAL: its centre in the PANEL's local frame (x = out of the wall, y = left, z = up),
// map 1's art/fan_props/power_anim.json "dial" (generated by its build_power_anim.py).
#define TOD_PDIAL_X              10.484
#define TOD_PDIAL_Y              -1.384
#define TOD_PDIAL_Z              28.075
#define TOD_PDIAL_TURNS          720     // two whole turns: it stops upright
#define TOD_PDIAL_SPIN           1.4     // seconds; eases in over the first quarter, out over the last 45%
#define TOD_PBOOT_DARK           0.15    // the screens drop out for this long at the press
#define TOD_PBOOT_STEP           0.35    // then each of the three RESTART GRID steps

// A point of the panel's local frame at org / yaw (x forward = out of the wall, y left, z up).
function panel_pt( org, yaw, local )
{
	fwd = AnglesToForward( ( 0, yaw, 0 ) );
	right = AnglesToRight( ( 0, yaw, 0 ) );
	return org + VectorScale( fwd, local[ 0 ] ) - VectorScale( right, local[ 1 ] ) + ( 0, 0, local[ 2 ] );
}

// The panel + its two moving pieces. Returns the DIAL (the press's sound and spark
// anchor) or undefined when the entity pool is full; a missing piece is cosmetic.
function spawn_at( org, yaw )
{
	angles = ( 0, yaw, 0 );
	m = Spawn( "script_model", org );
	if ( isdefined( m ) )
	{
		m.angles = angles;
		m SetModel( TOD_POWER_TERM_MODEL );
	}
	dial = Spawn( "script_model", panel_pt( org, yaw, ( TOD_PDIAL_X, TOD_PDIAL_Y, TOD_PDIAL_Z ) ) );
	if ( isdefined( dial ) )
	{
		dial.angles = angles;
		dial SetModel( "tod_power_dial" );
		dial NotSolid();
	}
	screen = Spawn( "script_model", org );   // the plates are authored in the panel's own frame: same origin, same angles
	if ( isdefined( screen ) )
	{
		screen.angles = angles;
		screen SetModel( "tod_power_screen_dark" );
		screen NotSolid();
		screen Hide();                       // until the press: the panel's own baked screen shows
	}
	level.tod_power_terminal = m;
	level.tod_pterm_dial = dial;
	level.tod_pterm_screen = screen;
	dev_log( "INIT rev=" + TOD_POWER_TERM_REVISION + " org=" + org + " yaw=" + yaw + " panel=" + isdefined( m )
		+ " dial=" + isdefined( dial ) + " screen=" + isdefined( screen ) );
	level thread power_watch();
	return dial;
}

// THE PRESS: the dial's two turns and the RESTART GRID lighting, ~TOD_PDIAL_SPIN long.
// BLOCKS until the screen reads POWER RESTORED (the caller turns the grid on next).
function boot( who )
{
	if ( IS_TRUE( level.tod_pterm_booting ) || IS_TRUE( level.tod_pterm_on ) )
		return;
	level.tod_pterm_booting = true;
	t0 = GetTime();
	dial = level.tod_pterm_dial;
	screen = level.tod_pterm_screen;
	by = "?";
	if ( isdefined( who ) && IsPlayer( who ) )
		by = who.name;
	dev_log( "BOOT_START by=" + by + " dial=" + isdefined( dial ) + " screen=" + isdefined( screen ) );
	// PK23 (2026-10-05): THE BOOT IS HEARD, from the screen: a capacitor charging under three confirm blips that land
	// on the three RESTART GRID frames (0.15 / 0.50 / 0.85 s) and an 'online' chirp as the screen comes on (1.20 s),
	// 1.4 s = the dial's spin. LOCKSTEP TOD_PBOOT_* / TOD_PDIAL_SPIN with tools/sfx/w2c_sounds (BOOT_BLIPS / BOOT_ON).
	// From a script_origin at the screen (a hidden screen model is not sent to clients, so never its own PlaySound).
	if ( isdefined( screen ) || isdefined( dial ) )
	{
		snd = Spawn( "script_origin", ( isdefined( screen ) ? screen.origin : dial.origin ) );
		if ( isdefined( snd ) )
		{
			snd PlaySound( "tod_power_boot" );
			snd thread boot_sound_cleanup();
		}
	}
	if ( isdefined( dial ) )
		dial RotateRoll( TOD_PDIAL_TURNS, TOD_PDIAL_SPIN, TOD_PDIAL_SPIN * 0.25, TOD_PDIAL_SPIN * 0.45 );
	frames = array( "tod_power_screen_dark", "tod_power_screen_f1", "tod_power_screen_f2", "tod_power_screen_f3" );
	holds = array( TOD_PBOOT_DARK, TOD_PBOOT_STEP, TOD_PBOOT_STEP, TOD_PBOOT_STEP );
	for ( i = 0; i < frames.size; i++ )
	{
		if ( isdefined( screen ) )
		{
			screen SetModel( frames[ i ] );
			screen Show();
		}
		dev_log( "BOOT_FRAME " + frames[ i ] + " at_ms=" + ( GetTime() - t0 ) );
		wait holds[ i ];
	}
	if ( isdefined( screen ) )
		screen SetModel( "tod_power_screen" );   // the base model = ON
	dev_log( "BOOT_FRAME tod_power_screen (on) at_ms=" + ( GetTime() - t0 ) );
	if ( isdefined( dial ) )
	{
		left = TOD_PDIAL_SPIN - ( GetTime() - t0 ) / 1000.0;
		if ( left > 0 )
			wait left;                       // the spin's own end, upright
		dial SetModel( "tod_power_dial_on" );
	}
	level.tod_pterm_on = true;
	level.tod_pterm_booting = false;
	dev_log( "BOOT_DONE ms=" + ( GetTime() - t0 ) );
}

function boot_sound_cleanup()   // self = the boot cue's temp host (PK23)
{
	wait 3;
	if ( isdefined( self ) )
		self Delete();
}

// A power_on that did not come through the press (the pool-full fallback, a dev
// harness): show ON directly, one frame after the flag so a press in the same frame
// claims it first.
function power_watch()
{
	level endon( "end_game" );
	if ( !level flag::exists( "power_on" ) )
	{
		dev_log( "FAIL no power_on flag - the panel stays in its OFF look" );
		return;
	}
	level flag::wait_till( "power_on" );
	WAIT_SERVER_FRAME;
	if ( !IS_TRUE( level.tod_pterm_booting ) && !IS_TRUE( level.tod_pterm_on ) )
		show_on( "power_on_without_the_press" );
}

function show_on( reason )
{
	level.tod_pterm_on = true;
	if ( isdefined( level.tod_pterm_screen ) )
	{
		level.tod_pterm_screen SetModel( "tod_power_screen" );
		level.tod_pterm_screen Show();
	}
	if ( isdefined( level.tod_pterm_dial ) )
		level.tod_pterm_dial SetModel( "tod_power_dial_on" );
	dev_log( "ON_DIRECT reason=" + reason );
}

function dev_log( msg )
{
	if ( !( IS_TRUE( level.tod_dev ) || IS_TRUE( level.tod_diag ) ) ) return;
	line = "[TOD_POWER_TERM] ms=" + GetTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}
