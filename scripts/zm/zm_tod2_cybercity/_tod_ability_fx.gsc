// =============================================================================
// _tod_ability_fx.gsc - THE ABILITY FEEDBACK, server half (docs/203, 2026-10-02).
//
// User: "Tower of Doom 1 has such good visual effects on the players abilities and
// I feel this map lacks that interaction and awesome visuals ... Dash upgrade could
// use some, The soul pulse is super ugly and dull ... Breacher explosive jump and
// heal ... Demon Slayer activation ... how they look in 3d world from other
// perspectives too".
//
// ONE OWNER for what a class ability LOOKS and SOUNDS like, in both views:
//   * the CASTER sees a first-person half (a viewmodel light, a camera effect, a
//     screen tint) that never blinds them;
//   * a TEAMMATE sees a body half on the caster (a streak, an aura, a burst at the
//     feet) that reads from across the hall;
//   * everyone hears a start and an end.
// The class modules keep their mechanics and call in here at the moment of the
// cast. This module imports NONE of them (no cycles): _tod_class_kit,
// _tod_class_cards, _tod_necro_summon, _tod_archer and _tod_retriever #using it.
//
// THE LANE: every world effect is played by the CLIENT (_tod_ability_fx.csc), the
// map's proven lane (a bare server PlayFX does not render here). The server sends
// ONE event: "tod_abfx_kind" (the event, LOCKSTEP table below) then the counter
// "tod_abfx" (the trigger) - the kind is registered BEFORE the counter so the
// client applies it first (the Soul Pulse band's lesson, _tod_necro_skull.gsc). Two
// events on one player in one frame would lose the first, so play() defers the
// second by a frame. Looping body states (the Demon aura, the Fusion air trail)
// ride "tod_abfx_state" (bits) so a late joiner sees them too.
//
// The effects are GENERATED by tools/ability_fx/gen_fx.py (share/raw/fx/tod/abfx);
// the sounds are sound/aliases/tod_ability.csv. Gate: tools/test_ability_fx.js.
//
// LOGS (dev): [TOD_ABFX] INIT, PLAY kind= player=, STATE, DEMON_ON / DEMON_OFF,
// DEFER (two events in one frame), SOUND_DROPPED.
// =============================================================================
// THE SECOND PASS (docs/206, 2026-10-03; user: "Any tweaks or enhancements we can make on
// upgrade moves special effects or sounds? ... implement everything else you find will
// improve the experience"): the Cyber Smash DIVE (a landing mark on the traced floor + a
// streak in the air + the falling whistle), the CHARGED blade a teammate can see (a glow on
// the sword hand while the slam is ready, a flash + sting when it charges), the CLOAK's
// vanish / reappear bursts, A CARD TAKEN (a rarity-coloured burst on the body + a sting the
// party hears), the RIOT SHIELD's break (shards) and return (a glow pulse) on the proven
// sound lanes, the C4's ARMED blink + beep on the planted charge, the Archer's full DRAW
// glow + tick, PIERCING's through-hit, and two lanes that replace every bare server one-shot
// the first audit flagged (docs/203 s4): burst_at() (a tag_origin carrier that dies) and the
// actor hit lane (tod_abfx_hitk + tod_abfx_hit: the Retriever's hit, the pierce, the Rune
// Prison's torso fire, all drawn by the client on the zombie). The sounds are MADE FOR THE
// MOVES (tools/ability_fx/make_sounds.py: ElevenLabs takes scored per cue, an Uppbeat drop
// lane, a synthesised beep): every borrowed stock cue of the first pass is gone.
//
// LOGS (dev, the second pass): DIVE, SWORD, CARD, SHIELD, C4_ARMED, BURST / HIT (the first
// TOD_ABFX_LOG_BURSTS), FX_DROPPED (the entity pool refused a carrier).
#using scripts\shared\callbacks_shared;
#using scripts\shared\clientfield_shared;
#using scripts\shared\system_shared;
#using scripts\shared\util_shared;
#using scripts\shared\laststand_shared;

#insert scripts\shared\shared.gsh;
#insert scripts\shared\version.gsh;

#precache( "material", "tod_demon_vignette" );
#precache( "material", "tod_fusion_vignette" );
// the server-played carriers (docs/206): the dive's landing mark, the C4's blink
#precache( "fx", "tod/abfx/fx_abfx_dive_ring" );
#precache( "fx", "tod/abfx/fx_abfx_c4_blink" );
#precache( "eventstring", "tod_kit_deny" );   // PK18: a refused press pulses its tile red (TodAbilityFeedback.Refused)

#namespace tod_ability_fx;

// ---- THE EVENT KINDS (LOCKSTEP _tod_ability_fx.csc) ----------------------------------
#define TOD_ABFX_NONE              0
#define TOD_ABFX_DASH_SWORD        1   // BASH: the dash begins (the held blade picks the streak)
#define TOD_ABFX_DASH_GAUNTLET     2
#define TOD_ABFX_DASH_PUNCH        3
#define TOD_ABFX_BASH_IMPACT       4   // BASH: the end burst, the ordinary radius
#define TOD_ABFX_BASH_IMPACT_LV9   5   // BASH: the Lv9 wider burst
#define TOD_ABFX_PULSE_0           6   // SOUL PULSE: the dome, band 0..3 (LOCKSTEP _tod_necro_summon bomb band)
#define TOD_ABFX_PULSE_3           9
#define TOD_ABFX_FUSION_HEAL      10   // EXPLOSIVE FUSION: healed by your own blast
#define TOD_ABFX_FUSION_LAUNCH    11   // EXPLOSIVE FUSION: the launch
#define TOD_ABFX_FUSION_LAND      12   // EXPLOSIVE FUSION: the landing
#define TOD_ABFX_DEMON_ON         13   // DEMON SLAYER: the window opens
#define TOD_ABFX_DEMON_OFF        14   // DEMON SLAYER: the window closes
// docs/206
#define TOD_ABFX_CLOAK_ON         15   // INVISIBILITY CLOAK: the vanish burst
#define TOD_ABFX_CLOAK_OFF        16   // INVISIBILITY CLOAK: the reappear burst
#define TOD_ABFX_CARD_1           17   // A CARD TAKEN: COMMON .. LEGENDARY = CARD_1 .. CARD_4 (rarity 1..4)
#define TOD_ABFX_CARD_4           20
#define TOD_ABFX_SHIELD_BREAK     21   // RIOT SHIELD: the shards
#define TOD_ABFX_SHIELD_BACK      22   // RIOT SHIELD: the glow pulse on the return
#define TOD_ABFX_SWORD_CHARGED    23   // CYBER SMASH: the blade just charged (one flash; the glow rides the state)
#define TOD_ABFX_DRAW_FULL        24   // THE BOW at full draw (a viewmodel glow, the caster only)
#define TOD_ABFX_KIND_BITS         5

// ---- THE BODY STATES (bits, LOCKSTEP .csc) ----------------------------------------------
#define TOD_ABFX_STATE_DEMON       1   // the red aura + light on the body
#define TOD_ABFX_STATE_AIR         2   // the Fusion ember trail while airborne
#define TOD_ABFX_STATE_DIVE        4   // the Cyber Smash dive streak (docs/206)
#define TOD_ABFX_STATE_SWORD       8   // the charged blade's glow on the sword hand (docs/206)
#define TOD_ABFX_STATE_BITS        4

// ---- THE ACTOR HIT LANE (LOCKSTEP .csc): tod_abfx_hitk (the kind) then tod_abfx_hit (the counter) -----
#define TOD_ABFX_HIT_PIERCE        1   // PIERCING's through-hit (a flesh hit at the chest)
#define TOD_ABFX_HIT_AXE           2   // the Retriever's hit (the archer impact)
#define TOD_ABFX_HIT_BURN          3   // the Rune Prison's torso fire, TOD_ABFX_BURN_SECS long
#define TOD_ABFX_HIT_BITS          2
#define TOD_ABFX_BURN_SECS         4.0   // LOCKSTEP _tod_archer_rune TOD_RUNE_TRAP_MS (the fire holds what it catches this long)
#define TOD_ABFX_DIVE_RING_MAX     6.0   // a dive's landing mark can live this long at most (TOD_GS_DIVE_MAX_MS)
#define TOD_ABFX_BURST_LIFE        2.0   // a carrier for a one-shot world effect lives this long by default
#define TOD_ABFX_SWORD_QUIET_MS    2000  // no charged sting in the first moments of a life (the state is re-sent on every spawn)
#define TOD_ABFX_LOG_BURSTS        20

// ---- the screen tints (server hudelems, the proven fullscreen shape) --------------------
#define TOD_ABFX_DEMON_ALPHA       0.30   // the red edge tint while Demon Slayer runs
#define TOD_ABFX_DEMON_IN_S        0.25
#define TOD_ABFX_DEMON_OUT_S       1.0    // the last second of the window reads as the end
#define TOD_ABFX_HEAL_ALPHA        0.35   // the orange flash of a Fusion heal
#define TOD_ABFX_HEAL_OUT_S        0.45
#define TOD_ABFX_SOUND_LIFE        4      // a 3D cue's script_origin lives this long
#define TOD_ABFX_DENY_GAP_MS       1500   // PK18: one "nope" per player per this long, however many presses / reasons
#define TOD_ABFX_READY_GAP_MS      400    // PK18: two ready edges in one breath (a capacity grant + a recharge) = one cue

// _tod_main::init runs AFTER the engine closes clientfield registration; REGISTER_SYSTEM's
// __init__ runs before it (the pattern every clientfield module here follows). LOCKSTEP .csc.
REGISTER_SYSTEM( "tod_ability_fx", &__init__, undefined )
function __init__()
{
	clientfield::register( "allplayers", "tod_abfx_kind", VERSION_SHIP, TOD_ABFX_KIND_BITS, "int" );     // BEFORE the counter (applied first)
	clientfield::register( "allplayers", "tod_abfx", VERSION_SHIP, 1, "counter" );
	clientfield::register( "allplayers", "tod_abfx_state", VERSION_SHIP, TOD_ABFX_STATE_BITS, "int" );
	clientfield::register( "actor", "tod_abfx_soul", VERSION_SHIP, 1, "counter" );   // an elite struck by the Soul Pulse
	clientfield::register( "actor", "tod_abfx_hitk", VERSION_SHIP, TOD_ABFX_HIT_BITS, "int" );   // the hit kind, applied BEFORE the counter (docs/206)
	clientfield::register( "actor", "tod_abfx_hit", VERSION_SHIP, 1, "counter" );   // a zombie struck: the client draws the kind on it
	callback::on_spawned( &on_spawned );
}

function init()
{
	level.tod_abfx_on = true;
	level.tod_abfx_rev = 2;
	level.tod_abfx_bursts = 0;
	dev_log( "INIT rev=" + level.tod_abfx_rev + " kinds=" + TOD_ABFX_DRAW_FULL + " states=" + ( TOD_ABFX_STATE_DEMON | TOD_ABFX_STATE_AIR | TOD_ABFX_STATE_DIVE | TOD_ABFX_STATE_SWORD ) + " hits=" + TOD_ABFX_HIT_BURN );
}

// a fresh life carries no body state (the Demon aura, the trail, the dive streak, the glow): the owners re-assert theirs
function on_spawned()   // self = player
{
	self.tod_abfx_state = 0;
	self.tod_abfx_demon = undefined;
	self.tod_abfx_spawn_ms = GetTime();
	self clientfield::set( "tod_abfx_state", 0 );
	self dive_ring_kill();
}

// =============================================================================
// THE EVENT: play( player, kind ). Never waits on the caller's thread.
// =============================================================================
function play( player, kind )
{
	if ( !isdefined( player ) || !IsPlayer( player ) || !isdefined( kind ) || kind <= TOD_ABFX_NONE ) return;
	now = GetTime();
	if ( isdefined( player.tod_abfx_frame_ms ) && player.tod_abfx_frame_ms == now )
	{
		// a second event this frame would overwrite the first's kind before the client read it
		dev_log( "DEFER kind=" + kind + " player=" + player GetEntityNumber() );
		player thread play_later( kind );
		return;
	}
	player.tod_abfx_frame_ms = now;
	player clientfield::set( "tod_abfx_kind", kind );
	player clientfield::increment( "tod_abfx" );
	dev_log( "PLAY kind=" + kind + " player=" + player GetEntityNumber() + " origin=" + player.origin );
}

function play_later( kind )   // self = player
{
	self endon( "disconnect" );
	wait 0.05;
	if ( !isdefined( self ) ) return;
	play( self, kind );
}

// THE BODY STATE: a bit on / off (the client starts or stops the looping body effect).
function state( player, bit, on )
{
	if ( !isdefined( player ) || !IsPlayer( player ) ) return;
	cur = ( isdefined( player.tod_abfx_state ) ? player.tod_abfx_state : 0 );
	next = cur;
	if ( on && ( cur & bit ) == 0 ) next = cur + bit;        // GSC has no ~ : add / subtract the bit
	else if ( !on && ( cur & bit ) != 0 ) next = cur - bit;
	if ( next == cur ) return;
	player.tod_abfx_state = next;
	player clientfield::set( "tod_abfx_state", next );
	dev_log( "STATE player=" + player GetEntityNumber() + " bit=" + bit + " on=" + on + " value=" + next );
}

// AN ELITE STRUCK BY THE SOUL PULSE: the soul-rip flash on its chest and head (the client).
function actor_soul( z )
{
	if ( !isdefined( z ) || !IsAlive( z ) ) return;
	z clientfield::increment( "tod_abfx_soul" );
}

// =============================================================================
// THE PIECES THE CLASS MODULES CALL
// =============================================================================
// BASH: the dash begins. blade = the held blade's weapon (its name picks the streak).
function bash_dash( player, blade )
{
	kind = TOD_ABFX_DASH_PUNCH;
	if ( isdefined( blade ) && isdefined( blade.name ) )
	{
		if ( IsSubStr( blade.name, "cc_gold_sword" ) ) kind = TOD_ABFX_DASH_SWORD;
		else if ( IsSubStr( blade.name, "cc_gauntlet" ) ) kind = TOD_ABFX_DASH_GAUNTLET;
	}
	play( player, kind );
	player PlayLocalSound( "tod_abfx_dash_plr" );
	sound_3d( player.origin, "tod_abfx_dash_3d" );
}

// BASH: the end burst. lv9 = the wider burst.
function bash_impact( player, lv9 )
{
	play( player, ( IS_TRUE( lv9 ) ? TOD_ABFX_BASH_IMPACT_LV9 : TOD_ABFX_BASH_IMPACT ) );
	player PlayLocalSound( "tod_abfx_impact_plr" );
	sound_3d( player.origin, "tod_abfx_impact_3d" );
}

// SOUL PULSE: the dome, band 0..3 (the necro's own ring + souls still play beside it).
function soul_pulse( player, band )
{
	if ( !isdefined( band ) ) band = 0;
	if ( band < 0 ) band = 0;
	if ( band > 3 ) band = 3;
	play( player, TOD_ABFX_PULSE_0 + band );
	player PlayLocalSound( "tod_abfx_pulse_plr" );
	sound_3d( player.origin, "tod_abfx_pulse_3d" );
}

// EXPLOSIVE FUSION: healed by your own blast (once per blast, never per tick).
function fusion_heal( player )
{
	play( player, TOD_ABFX_FUSION_HEAL );
	player PlayLocalSound( "tod_abfx_heal_plr" );
	player thread tint_flash( "tod_fusion_vignette", TOD_ABFX_HEAL_ALPHA, 0, TOD_ABFX_HEAL_OUT_S );
}

// EXPLOSIVE FUSION: the launch - the burst under the feet, the ember trail until the landing.
function fusion_launch( player )
{
	play( player, TOD_ABFX_FUSION_LAUNCH );
	state( player, TOD_ABFX_STATE_AIR, true );
	player PlayLocalSound( "tod_abfx_launch_plr" );
	player PlayRumbleOnEntity( "damage_heavy" );
	sound_3d( player.origin, "tod_abfx_launch_3d" );
}

// EXPLOSIVE FUSION: the landing - the dust ring, the thud, the trail ends.
function fusion_land( player )
{
	state( player, TOD_ABFX_STATE_AIR, false );
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_FUSION_LAND );
	player PlayLocalSound( "tod_abfx_land_plr" );
	player PlayRumbleOnEntity( "damage_light" );
	sound_3d( player.origin, "tod_abfx_land_3d" );
}

// DEMON SLAYER: the window opens (or is refreshed by another elite kill). The watcher reads
// player.tod_demon_until so a refresh extends the aura; ONE watcher per player.
function demon_on( player, ms )
{
	if ( !isdefined( player ) ) return;
	refresh = IS_TRUE( player.tod_abfx_demon );
	player.tod_abfx_demon = true;
	state( player, TOD_ABFX_STATE_DEMON, true );
	play( player, TOD_ABFX_DEMON_ON );
	player PlayLocalSound( "tod_abfx_demon_on_plr" );
	player PlayRumbleOnEntity( "damage_heavy" );
	sound_3d( player.origin, "tod_abfx_demon_on_3d" );
	dev_log( "DEMON_ON player=" + player GetEntityNumber() + " ms=" + ms + " refresh=" + refresh );
	player thread demon_watch();
}

function demon_watch()   // self = player
{
	self notify( "tod_abfx_demon_watch" );
	self endon( "tod_abfx_demon_watch" );
	self endon( "disconnect" );
	level endon( "end_game" );
	self thread tint_hold( "tod_demon_vignette", TOD_ABFX_DEMON_ALPHA, TOD_ABFX_DEMON_IN_S );
	// hold until the window (which another kill may extend) is in its last second
	while ( isdefined( self.tod_demon_until ) && GetTime() < self.tod_demon_until - int( TOD_ABFX_DEMON_OUT_S * 1000 ) )
	{
		if ( !IsAlive( self ) || self laststand::player_is_in_laststand() ) break;
		wait 0.1;
	}
	self demon_end( "window" );
}

function demon_end( why )   // self = player
{
	if ( !IS_TRUE( self.tod_abfx_demon ) ) return;
	self.tod_abfx_demon = undefined;
	self notify( "tod_abfx_demon_watch" );
	self thread tint_release( TOD_ABFX_DEMON_OUT_S );
	state( self, TOD_ABFX_STATE_DEMON, false );
	play( self, TOD_ABFX_DEMON_OFF );
	self PlayLocalSound( "tod_abfx_demon_off_plr" );
	dev_log( "DEMON_OFF player=" + self GetEntityNumber() + " why=" + why );
}

// a down / death / class change: everything body-side off at once
function clear( player, why )
{
	if ( !isdefined( player ) ) return;
	if ( IS_TRUE( player.tod_abfx_demon ) ) player demon_end( why );
	state( player, TOD_ABFX_STATE_AIR, false );
	state( player, TOD_ABFX_STATE_DIVE, false );
	state( player, TOD_ABFX_STATE_SWORD, false );
	player dive_ring_kill();
	player thread tint_release( 0.2 );
}

// =============================================================================
// docs/206: THE SECOND PASS
// =============================================================================
// CYBER SMASH, the air dive begins: the streak on the body (a state), a landing MARK on the floor the
// dive traced (a looping ring on a server carrier - the proven PlayFXOnTag-on-tag_origin lane - that
// dies with the dive), the falling whistle in both ears. floor_org = the traced floor point.
function dive_start( player, floor_org )
{
	if ( !isdefined( player ) ) return;
	state( player, TOD_ABFX_STATE_DIVE, true );
	player dive_ring_kill();
	if ( isdefined( floor_org ) )
	{
		host = Spawn( "script_model", floor_org + ( 0, 0, 2 ) );
		if ( isdefined( host ) )
		{
			host SetModel( "tag_origin" );
			player.tod_abfx_dive_ring = host;
			host thread ring_run( "tod/abfx/fx_abfx_dive_ring", TOD_ABFX_DIVE_RING_MAX );
		}
		else dev_log( "FX_DROPPED effect=dive_ring reason=entity_pool_full" );
	}
	player PlayLocalSound( "tod_abfx_dive_plr" );
	sound_3d( player.origin, "tod_abfx_dive_3d" );
	dev_log( "DIVE player=" + player GetEntityNumber() + " floor=" + ( isdefined( floor_org ) ? floor_org : "none" ) );
}

// the dive ended (landed, blocked, cancelled): the streak and the mark go (the slam's own burst lands)
function dive_end( player )
{
	if ( !isdefined( player ) ) return;
	state( player, TOD_ABFX_STATE_DIVE, false );
	player dive_ring_kill();
}

function dive_ring_kill()   // self = player
{
	if ( isdefined( self.tod_abfx_dive_ring ) ) self.tod_abfx_dive_ring Delete();
	self.tod_abfx_dive_ring = undefined;
}

// CYBER SMASH charged / spent: the glow on the sword hand everyone sees while the slam is ready; the rising
// edge flashes the blade for the others and plays the charged sting to the Warrior (not in a life's first
// TOD_ABFX_SWORD_QUIET_MS: the readiness is re-sent on every spawn). Called every HUD tick; cheap when unchanged.
function sword_ready( player, on )
{
	if ( !isdefined( player ) ) return;
	was = ( isdefined( player.tod_abfx_state ) && ( player.tod_abfx_state & TOD_ABFX_STATE_SWORD ) != 0 );
	if ( IS_TRUE( on ) == was ) return;
	state( player, TOD_ABFX_STATE_SWORD, IS_TRUE( on ) );
	if ( !IS_TRUE( on ) ) return;
	quiet = ( isdefined( player.tod_abfx_spawn_ms ) && GetTime() - player.tod_abfx_spawn_ms < TOD_ABFX_SWORD_QUIET_MS );
	if ( !quiet )
	{
		play( player, TOD_ABFX_SWORD_CHARGED );
		player PlayLocalSound( "tod_abfx_charged_plr" );
	}
	dev_log( "SWORD player=" + player GetEntityNumber() + " charged=1 quiet=" + quiet );
}

// INVISIBILITY CLOAK: the vanish (a burst the teammates see, the cue in both ears) and the reappear
function cloak_on( player )
{
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_CLOAK_ON );
	player PlayLocalSound( "tod_abfx_cloak_on_plr" );
	sound_3d( player.origin, "tod_abfx_cloak_on_3d" );
}

function cloak_off( player )
{
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_CLOAK_OFF );
	player PlayLocalSound( "tod_abfx_cloak_off_plr" );
	sound_3d( player.origin, "tod_abfx_cloak_off_3d" );
}

// PK18 (2026-10-05): THE KIT COMES BACK. READY = a charge or a cooldown returned: the Warrior's Bash charge, the
// Necromancer's Cloak off cooldown and Soul Pulse fully charged, the Breacher's C4 / Cluster round refill (before
// this they came back in silence - the tile flashed for a player whose eyes were on the horde). The player's ears
// only. Not news in a life's first TOD_ABFX_SWORD_QUIET_MS (the state re-settles on every spawn), nor while the
// player is down or mid jump-pad flight; two edges in TOD_ABFX_READY_GAP_MS are one cue.
function kit_ready( player, kind )
{
	if ( !isdefined( player ) || !IsPlayer( player ) || !IsAlive( player ) ) return;
	if ( player laststand::player_is_in_laststand() || IS_TRUE( player.tod_jumppad_flying ) ) return;
	now = GetTime();
	if ( isdefined( player.tod_abfx_spawn_ms ) && now - player.tod_abfx_spawn_ms < TOD_ABFX_SWORD_QUIET_MS ) return;
	if ( isdefined( player.tod_abfx_ready_ms ) && now - player.tod_abfx_ready_ms < TOD_ABFX_READY_GAP_MS ) return;
	if ( kind == "bash" ) player PlayLocalSound( "tod_abfx_bash_ready_plr" );
	else if ( kind == "cloak" ) player PlayLocalSound( "tod_abfx_cloak_ready_plr" );
	else if ( kind == "pulse" ) player PlayLocalSound( "tod_abfx_pulse_charged_plr" );
	else if ( kind == "refill" ) player PlayLocalSound( "tod_abfx_refill_plr" );
	else return;
	player.tod_abfx_ready_ms = now;
	dev_log( "KIT_READY player=" + player GetEntityNumber() + " kind=" + kind );
}

// PK18: REFUSED = a press the kit will not honour (Bash recharging, C4 / Cluster empty or locked, the Cloak on
// cooldown, the Soul Pulse still charging, a summon refused, a grapple refused): one muted two-pulse "nope" - never
// the purchase buzzer - per player per TOD_ABFX_DENY_GAP_MS, and the refused button's tile pulses red (the
// tod_kit_deny eventstring: slot 1 = the tactical tile, 2 = the lethal; a one-shot pulse, so no heartbeat - a HUD
// rebuilt mid-pulse simply misses one). The caller says which ability and why (the log).
function kit_deny( player, ability, why )
{
	if ( !isdefined( player ) || !IsPlayer( player ) ) return;
	now = GetTime();
	if ( isdefined( player.tod_abfx_deny_ms ) && now - player.tod_abfx_deny_ms < TOD_ABFX_DENY_GAP_MS ) return;
	player.tod_abfx_deny_ms = now;
	player PlayLocalSound( "tod_abfx_deny_plr" );
	slot = 0;
	if ( ability == "bash" || ability == "cloak" || ability == "cluster" || ability == "grapple" ) slot = 1;
	else if ( ability == "c4" || ability == "soul_pulse" ) slot = 2;
	if ( slot > 0 ) player LuiNotifyEvent( &"tod_kit_deny", 1, slot );
	dev_log( "KIT_DENY player=" + player GetEntityNumber() + " ability=" + ability + " why=" + why + " tile=" + slot );
}

// A CARD TAKEN: a rarity-coloured burst on the body (COMMON white .. LEGENDARY gold + a light) and the
// rarity's sting at the body, so a teammate sees and hears a LEGENDARY land across the hall.
function card_taken( player, rarity )
{
	if ( !isdefined( player ) ) return;
	r = 1;
	if ( isdefined( rarity ) ) r = int( rarity );
	if ( r < 1 ) r = 1;
	if ( r > 4 ) r = 4;
	play( player, TOD_ABFX_CARD_1 + r - 1 );
	sound_3d( player.origin, "tod_abfx_card_" + r + "_3d" );
	dev_log( "CARD player=" + player GetEntityNumber() + " rarity=" + r );
}

// RIOT SHIELD: the break (shards + the crack, both ears; the old PlaySoundAtPosition lane was silent for a
// custom alias here) and the return (a glow pulse + its own cue, not the lounge chime).
function shield_break( player )
{
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_SHIELD_BREAK );
	player PlayLocalSound( "tod_abfx_shield_break_plr" );
	sound_3d( player.origin, "tod_abfx_shield_break_3d" );
	dev_log( "SHIELD player=" + player GetEntityNumber() + " break" );
}

function shield_back( player )
{
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_SHIELD_BACK );
	player PlayLocalSound( "tod_abfx_shield_back_plr" );
	dev_log( "SHIELD player=" + player GetEntityNumber() + " back" );
}

// THE BOW at full draw: a glow on the viewmodel and a tick, the caster only (once per draw).
function draw_full( player )
{
	if ( !isdefined( player ) ) return;
	play( player, TOD_ABFX_DRAW_FULL );
	player PlayLocalSound( "tod_abfx_draw_plr" );
}

// THE ACTOR HIT LANE: the client draws `kind` on the zombie (the kind field is applied before the counter).
function actor_hit( z, kind )
{
	if ( !isdefined( z ) || !IsAlive( z ) ) return;
	z clientfield::set( "tod_abfx_hitk", kind );
	z clientfield::increment( "tod_abfx_hit" );
	if ( !isdefined( level.tod_abfx_bursts ) ) level.tod_abfx_bursts = 0;
	level.tod_abfx_bursts++;
	if ( level.tod_abfx_bursts <= TOD_ABFX_LOG_BURSTS ) dev_log( "HIT kind=" + kind + " zombie=" + z GetEntityNumber() );
}

// PIERCING: the through-hit on a pierced zombie (a flesh hit at its chest + the cue). Call it BEFORE the damage.
function pierce_hit( z )
{
	if ( !isdefined( z ) ) return;
	actor_hit( z, TOD_ABFX_HIT_PIERCE );
	sound_3d( z.origin, "tod_abfx_pierce_3d" );
}

// THE RETRIEVER's hit on a zombie (the archer impact, drawn by the client; the axe's own hit sound plays).
function axe_hit( z )
{
	actor_hit( z, TOD_ABFX_HIT_AXE );
}

// THE RUNE PRISON's torso fire on a trapped zombie, TOD_ABFX_BURN_SECS long (a server PlayFXOnTag on an
// actor does not render here, _tod_boss_fx.gsc).
function burn( z )
{
	actor_hit( z, TOD_ABFX_HIT_BURN );
}

// STICKY C4 armed: a blinking red light + a beep loop on a carrier that rides the planted charge until it goes
// (the charge is a networked missile; the carrier follows it through its stick and re-bone and dies with it).
// -> the carrier, or undefined.
function c4_armed( grenade )
{
	if ( !isdefined( grenade ) ) return undefined;
	host = Spawn( "script_model", grenade.origin );
	if ( !isdefined( host ) )
	{
		dev_log( "FX_DROPPED effect=c4_blink reason=entity_pool_full" );
		return undefined;
	}
	host SetModel( "tag_origin" );
	host LinkTo( grenade );
	host thread c4_blink_run( grenade );
	dev_log( "C4_ARMED grenade=" + grenade GetEntityNumber() );
	return host;
}

function c4_blink_run( grenade )   // self = the carrier
{
	self endon( "death" );
	wait 0.05;   // one frame: the entity before its effect (every carrier here waits it)
	PlayFXOnTag( "tod/abfx/fx_abfx_c4_blink", self, "tag_origin" );
	self PlayLoopSound( "tod_abfx_c4_loop" );
	self thread c4_follow( grenade );
	wait 180;   // a charge nobody ever set off: the blink does not outlive the match's patience
	self Delete();
}

function c4_follow( grenade )   // self = the carrier: gone the frame the charge is (explode, pickup, owner gone)
{
	self endon( "death" );
	if ( isdefined( grenade ) ) grenade waittill( "death" );
	self StopLoopSound();
	self Delete();
}

// A ONE-SHOT WORLD EFFECT at a position: a bare server PlayFX does not render here (docs/203 s4), so it
// rides a tag_origin carrier that dies after `life` (the hook's bite, the Rune Prison's impact / eruption /
// end). angles: the donor's forward (( -90, 0, 0 ) = up for an effect authored along +Z). -> nothing.
function burst_at( fx, org, angles, life )
{
	if ( !isdefined( fx ) || !isdefined( org ) ) return;
	host = Spawn( "script_model", org );
	if ( !isdefined( host ) )
	{
		dev_log( "FX_DROPPED effect=" + fx + " reason=entity_pool_full" );
		return;
	}
	host SetModel( "tag_origin" );
	if ( isdefined( angles ) ) host.angles = angles;
	if ( !isdefined( life ) ) life = TOD_ABFX_BURST_LIFE;
	if ( !isdefined( level.tod_abfx_bursts ) ) level.tod_abfx_bursts = 0;
	level.tod_abfx_bursts++;
	if ( level.tod_abfx_bursts <= TOD_ABFX_LOG_BURSTS ) dev_log( "BURST fx=" + fx + " at=" + org + " life=" + life );
	host thread ring_run( fx, life );
}

// =============================================================================
// THE LANDING RING (the Archer's charge / landing tell): a short-lived host linked to
// the player. The old call was a looping PlayFXOnTag on the player that nothing ever
// stopped (docs/203 s4: rings could pile up). The host dies, so the ring does.
// =============================================================================
function ring_at( player, fx, secs )
{
	if ( !isdefined( player ) ) return;
	host = Spawn( "script_model", player.origin );
	if ( !isdefined( host ) ) return;
	host SetModel( "tag_origin" );
	host LinkTo( player );
	host thread ring_run( fx, secs );
}

function ring_run( fx, secs )   // self = the host
{
	self endon( "death" );
	wait 0.05;   // one frame: an effect played in the host's spawn frame can reach the client before the entity
	PlayFXOnTag( fx, self, "tag_origin" );
	wait secs;
	if ( isdefined( self ) ) self Delete();
}

// =============================================================================
// helpers
// =============================================================================
// A custom 3D alias plays from a spawned script_origin's PlaySound, never
// PlaySoundAtPosition (that lane was silent for custom aliases; CLAUDE.md v19.21c).
function sound_3d( org, alias )
{
	e = Spawn( "script_origin", org );
	if ( !isdefined( e ) )
	{
		dev_log( "SOUND_DROPPED alias=" + alias + " reason=entity_pool_full" );
		return;
	}
	e PlaySound( alias );
	e thread sound_expire( TOD_ABFX_SOUND_LIFE );
}

function sound_expire( secs )
{
	self endon( "death" );
	wait secs;
	if ( isdefined( self ) ) self Delete();
}

// The fullscreen tint hudelem (the proven ACC shape: fullscreen alignment, top-left
// anchor, drawn at the 640x480 virtual size, behind every other element).
function tint_ensure()   // self = player
{
	if ( isdefined( self.tod_abfx_tint ) ) return;
	h = NewClientHudElem( self );
	h.horzAlign = "fullscreen";
	h.vertAlign = "fullscreen";
	h.alignX = "left";
	h.alignY = "top";
	h.x = 0;
	h.y = 0;
	h.alpha = 0;
	h.sort = -2;
	h.archived = false;
	h.hidewheninmenu = true;
	h SetShader( "tod_demon_vignette", 640, 480 );
	self.tod_abfx_tint = h;
}

// a flash: in to `alpha` over in_s, out over out_s (the Fusion heal)
function tint_flash( mat, alpha, in_s, out_s )   // self = player
{
	self endon( "disconnect" );
	if ( IS_TRUE( self.tod_abfx_demon ) ) return;   // the demon tint owns the element while it runs
	self tint_ensure();
	h = self.tod_abfx_tint;
	if ( !isdefined( h ) ) return;
	h SetShader( mat, 640, 480 );
	h.alpha = alpha;
	h FadeOverTime( out_s );
	h.alpha = 0;
}

// a hold: in over in_s and stay (released by tint_release)
function tint_hold( mat, alpha, in_s )   // self = player
{
	self endon( "disconnect" );
	self tint_ensure();
	h = self.tod_abfx_tint;
	if ( !isdefined( h ) ) return;
	h SetShader( mat, 640, 480 );
	h FadeOverTime( in_s );
	h.alpha = alpha;
}

function tint_release( out_s )   // self = player
{
	self endon( "disconnect" );
	h = self.tod_abfx_tint;
	if ( !isdefined( h ) ) return;
	h FadeOverTime( out_s );
	h.alpha = 0;
}

function dev_log( msg )
{
	if ( !( IS_TRUE( level.tod_dev ) || IS_TRUE( level.tod_diag ) ) ) return;
	line = "[TOD_ABFX] ms=" + GetTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}
