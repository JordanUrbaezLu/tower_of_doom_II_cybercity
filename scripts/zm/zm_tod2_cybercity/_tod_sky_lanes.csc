// GENERATED by tools/sky_ships/gen_lanes.js from map_source + art/sky_ships/manifest.json - DO NOT HAND-EDIT.
// THE SKY FLEET flight data (docs/192). Lanes: array( a, b, bands ) where a/b are the ends of a straight
// pass (the ship ORIGIN, z = 0; fly either way) and bands = [ ( zlo, zhi, 0 ), ... ] the origin altitudes
// where the whole ship - with its wing and its weave / bob / bank - clears every brush and keep-out box by
// 1500 units and stays inside the sealed volume. Beyond a lane's ends a ship is drawn as a scaled
// stand-in (blockers() lists what it must never overlap). The build re-tests the committed data.

#namespace tod_sky_lanes;

function volume_lo() { return ( -12032, -12032, -416 ); }
function volume_hi() { return ( 12032, 12032, 39268 ); }

// Each ship class exported size (art/sky_ships/manifest.json): array( back, front, half_width, zlo, zhi ).
function size( ship )
{
	if ( ship == "dreadnought" ) return array( 6383, 5046, 2725, -850, 2442 );
	if ( ship == "hauler" ) return array( 3546, 3041, 927, -559, 990 );
	if ( ship == "gunship" ) return array( 1994, 1620, 1220, -250, 881 );
	if ( ship == "fighter" ) return array( 646, 470, 458, -91, 223 );
	return array( 1000, 1000, 500, -200, 200 );
}

// How each class flies (gen_lanes.js MOTION; docs/192 s9). approach = where it first appears, the distance at
// which it is spawn_px pixels long at 1080p. v4: hi_* = the high layer's schedule, convoy_* = followers on the
// lead's path (docs/192 s12).
function motion( ship )
{
	m = SpawnStruct();
	if ( ship == "dreadnought" )
	{
		m.speed = 380; m.xs = 6000; m.approach = 1112795;
		m.glide_min = 1; m.glide_max = 4; m.climb_min = 2; m.climb_max = 6;
		m.weave_a = 0; m.weave_t = 30; m.bob_a = 40; m.bob_t = 19; m.bank = 0;
		m.sway_roll = 1.5; m.sway_roll_t = 22; m.sway_pitch = 0.6; m.sway_pitch_t = 17;
		m.first = 20; m.gap_min = 30; m.gap_max = 75; m.cap = 1; m.wing_min = 1; m.wing_max = 1;
		m.worm_in = 40; m.worm_out = 30; m.worm_r = 4200; m.worm_approach = 222559;
		m.hi_first = 60; m.hi_gap_min = 90; m.hi_gap_max = 200; m.hi_cap = 1;
		m.convoy_pct = 0; m.convoy_min = 0; m.convoy_max = 0; m.convoy_gap = 0;
	}
	if ( ship == "hauler" )
	{
		m.speed = 520; m.xs = 5000; m.approach = 641391;
		m.glide_min = 1; m.glide_max = 5; m.climb_min = 2; m.climb_max = 7;
		m.weave_a = 60; m.weave_t = 26; m.bob_a = 60; m.bob_t = 13; m.bank = 3;
		m.sway_roll = 2.5; m.sway_roll_t = 15; m.sway_pitch = 1; m.sway_pitch_t = 11;
		m.first = 8; m.gap_min = 15; m.gap_max = 45; m.cap = 2; m.wing_min = 1; m.wing_max = 1;
		m.worm_in = 25; m.worm_out = 20; m.worm_r = 2000; m.worm_approach = 128278;
		m.hi_first = 14; m.hi_gap_min = 30; m.hi_gap_max = 90; m.hi_cap = 1;
		m.convoy_pct = 30; m.convoy_min = 1; m.convoy_max = 2; m.convoy_gap = 16;
	}
	if ( ship == "gunship" )
	{
		m.speed = 1000; m.xs = 4000; m.approach = 410542;
		m.glide_min = 2; m.glide_max = 7; m.climb_min = 3; m.climb_max = 9;
		m.weave_a = 260; m.weave_t = 10; m.bob_a = 110; m.bob_t = 7; m.bank = 14;
		m.sway_roll = 0; m.sway_roll_t = 10; m.sway_pitch = 0; m.sway_pitch_t = 10;
		m.first = 25; m.gap_min = 12; m.gap_max = 35; m.cap = 2; m.wing_min = 1; m.wing_max = 1;
		m.worm_in = 35; m.worm_out = 30; m.worm_r = 1900; m.worm_approach = 61581;
		m.hi_first = 35; m.hi_gap_min = 25; m.hi_gap_max = 70; m.hi_cap = 1;
		m.convoy_pct = 22; m.convoy_min = 1; m.convoy_max = 1; m.convoy_gap = 7;
	}
	if ( ship == "fighter" )
	{
		m.speed = 2200; m.xs = 3500; m.approach = 152075;
		m.glide_min = 3; m.glide_max = 9; m.climb_min = 4; m.climb_max = 12;
		m.weave_a = 300; m.weave_t = 6.5; m.bob_a = 140; m.bob_t = 5; m.bank = 32;
		m.sway_roll = 0; m.sway_roll_t = 10; m.sway_pitch = 0; m.sway_pitch_t = 10;
		m.first = 5; m.gap_min = 10; m.gap_max = 30; m.cap = 2; m.wing_min = 3; m.wing_max = 5;
		m.worm_in = 30; m.worm_out = 25; m.worm_r = 1900; m.worm_approach = 16897;
		m.hi_first = 10; m.hi_gap_min = 20; m.hi_gap_max = 60; m.hi_cap = 1;
		m.convoy_pct = 0; m.convoy_min = 0; m.convoy_max = 0; m.convoy_gap = 0;
	}
	return m;
}

// Blinking-light anchors in ship space (art/sky_ships/manifest.json): array( x, y, z, kind ), kind "s" = white
// strobe, "b" = red beacon.
function lights( ship )
{
	l = [];
	if ( ship == "dreadnought" )
	{
		l[ l.size ] = array( 4960, 0, 0, "s" );
		l[ l.size ] = array( -5650, 2150, -80, "s" );
		l[ l.size ] = array( -5650, -2150, -80, "s" );
		l[ l.size ] = array( 1530, 0, 1393, "b" );
		l[ l.size ] = array( -3400, 1720, 30, "s" );
		l[ l.size ] = array( -3400, -1720, 30, "s" );
		l[ l.size ] = array( -300, 0, -458, "b" );
		l[ l.size ] = array( 600, 0, 908, "b" );
	}
	if ( ship == "hauler" )
	{
		l[ l.size ] = array( 2980, 0, 0, "s" );
		l[ l.size ] = array( -3000, 0, 520, "s" );
		l[ l.size ] = array( -2700, 0, 1000, "b" );
		l[ l.size ] = array( 0, 0, -560, "b" );
		l[ l.size ] = array( 1560, 640, -520, "s" );
		l[ l.size ] = array( 1560, -640, -520, "s" );
	}
	if ( ship == "gunship" )
	{
		l[ l.size ] = array( -100, 1180, -50, "s" );
		l[ l.size ] = array( -100, -1180, -50, "s" );
		l[ l.size ] = array( -650, 0, 541, "b" );
		l[ l.size ] = array( 0, 0, -200, "b" );
	}
	if ( ship == "fighter" )
	{
		l[ l.size ] = array( -362, 446, -15, "s" );
		l[ l.size ] = array( -362, -446, -15, "s" );
	}
	return l;
}

// v3 THE FLAMES: each nozzle TAG (06_export.py: tag_eng_<i>, turned aft) = array( tag, radius, kind, main, ref, x, y, z ):
// kind 0 plasma_capital / 1 plasma / 2 fire / 3 fire_heavy (gen_fx.py), main = a glint when far, ref = the
// kind reference radius (its bucket 0).
function nozzles( ship )
{
	n = [];
	if ( ship == "dreadnought" )
	{
		n[ n.size ] = array( "tag_eng_0", 410, 0, 1, 410, -5600, 2150, -80 );
		n[ n.size ] = array( "tag_eng_1", 410, 0, 1, 410, -5600, -2150, -80 );
		n[ n.size ] = array( "tag_eng_2", 300, 0, 1, 410, -5260, -760, 0 );
		n[ n.size ] = array( "tag_eng_3", 300, 0, 1, 410, -5260, 0, 0 );
		n[ n.size ] = array( "tag_eng_4", 300, 0, 1, 410, -5260, 760, 0 );
		n[ n.size ] = array( "tag_eng_5", 95, 1, 0, 150, -5120, 1120, 250 );
		n[ n.size ] = array( "tag_eng_6", 95, 1, 0, 150, -5120, -1120, 250 );
		n[ n.size ] = array( "tag_eng_7", 95, 1, 0, 150, -5120, 1120, -250 );
		n[ n.size ] = array( "tag_eng_8", 95, 1, 0, 150, -5120, -1120, -250 );
		n[ n.size ] = array( "tag_eng_9", 80, 1, 0, 150, -5120, 380, 300 );
		n[ n.size ] = array( "tag_eng_10", 80, 1, 0, 150, -5120, -380, 300 );
		n[ n.size ] = array( "tag_eng_11", 80, 1, 0, 150, -5120, 380, -300 );
		n[ n.size ] = array( "tag_eng_12", 80, 1, 0, 150, -5120, -380, -300 );
	}
	if ( ship == "hauler" )
	{
		n[ n.size ] = array( "tag_eng_0", 180, 3, 1, 180, -3200, -330, -215 );
		n[ n.size ] = array( "tag_eng_1", 180, 3, 1, 180, -3200, -330, 215 );
		n[ n.size ] = array( "tag_eng_2", 180, 3, 1, 180, -3200, 330, -215 );
		n[ n.size ] = array( "tag_eng_3", 180, 3, 1, 180, -3200, 330, 215 );
	}
	if ( ship == "gunship" )
	{
		n[ n.size ] = array( "tag_eng_0", 150, 1, 1, 150, -1690, -200, -10 );
		n[ n.size ] = array( "tag_eng_1", 150, 1, 1, 150, -1690, 200, -10 );
	}
	if ( ship == "fighter" )
	{
		n[ n.size ] = array( "tag_eng_0", 78, 2, 1, 78, -470, 0, 0 );
	}
	return n;
}

// v3 THE ASTEROIDS (10_asteroids.py + 06_export.py): array( models, bounding radius, veins, pick weight % ).
function rocks()
{
	r = [];
	r[ r.size ] = array( array( "tod_sky_rock_1" ), 708.2, 0, 30 );
	r[ r.size ] = array( array( "tod_sky_rock_2" ), 655.6, 0, 22 );
	r[ r.size ] = array( array( "tod_sky_rock_3", "tod_sky_rock_3_b" ), 574.5, 1, 13 );
	r[ r.size ] = array( array( "tod_sky_rock_4", "tod_sky_rock_4_b" ), 645.2, 1, 15 );
	r[ r.size ] = array( array( "tod_sky_rock_5" ), 476.4, 0, 20 );
	return r;
}

// v3 THE BLACK HOLES: the painted holes where the game shows them (the sign at yaw 180 = -(SSI sun yaw + skyRotation);
// a body at azimuth A sits at yaw sign - A): array( centre dir, shadow radius deg, disc axis 1, disc axis 2, rocks,
// spin, name ).
function holes()
{
	h = [];
	h[ h.size ] = array( ( -0.148453, 0.554032, 0.819152 ), 3.6, ( 0.965926, 0.258819, 0 ), ( 0.209256, -0.780955, 0.588491 ), 9, 1, "gargantua" );   // az 75 -> yaw 105, el 55
	h[ h.size ] = array( ( -0.334546, -0.07111, 0.939693 ), 1.3, ( -0.207912, 0.978148, 0 ), ( 0.911641, 0.193775, 0.362438 ), 6, -1, "maelstrom" );   // az -12 -> yaw 192, el 70
	return h;
}

// v3 SHOOTING STARS + FIREBALLS: the runner speeds / lives baked into their effects (gen_fx.py STARS / FIREBALL).
function star_speed( v )
{
	if ( v == 0 ) return 9000;
	if ( v == 1 ) return 7000;
	if ( v == 2 ) return 5500;
	return 9000;
}
function star_secs( v )
{
	if ( v == 0 ) return 0.35;
	if ( v == 1 ) return 0.6;
	if ( v == 2 ) return 0.9;
	return 0.35;
}
function ball_speed() { return 2900; }
function ball_secs() { return 2.4; }

// Solids near the box walls a scaled stand-in must never overlap: array( lo, hi ).
function blockers()
{
	b = [];
	b[ b.size ] = array( ( -3464, 4660, 13296 ), ( 3464, 12304, 29296 ) );
	b[ b.size ] = array( ( -9336, -9336, -464 ), ( -6664, -6664, 1004 ) );
	b[ b.size ] = array( ( -8856, 7144, -464 ), ( -7144, 8856, 764 ) );
	b[ b.size ] = array( ( 6536, -9464, -464 ), ( 9464, -6536, 1164 ) );
	return b;
}

// The first-jump reveal flights (session 61's scene): fixed, checked paths.
function reveal_high()
{
	s = SpawnStruct();
	s.ship = "fighter"; s.a = ( -9500, 9500, 26000 ); s.b = ( -9500, -11000, 26000 );
	s.speed = 4800; s.approach = 8100; s.glide = 0; s.climb = 4;
	return s;
}
function reveal_low()
{
	s = SpawnStruct();
	s.ship = "hauler"; s.a = ( -8143, -8544, 24900 ); s.b = ( 8340, -5637, 24900 );
	s.speed = 520; s.approach = 997720; s.glide = 3; s.climb = 4;
	return s;
}

