// =============================================================================
// _tod_elite_fx.gsc - THE ELITES' EFFECTS (PK26, 2026-10-05): one owner for what the
// elites' big moments LOOK like.
//
//   * THE DEATH CHARGE: a dying Doppelghast builds up for TOD_ELITE_FX_CHARGE_MS before
//     its blast (which hurts: _tod_doppelghast TOD_DOPPEL_DEATH_*) - a red core swelling
//     to white, an accelerating heartbeat of flashes, sparks rushing in, arcs, a throbbing
//     red light and a rising charge whine. Before this the only tell was a blood spray.
//   * THE DEATH BLAST: on the floor under the corpse - the flash, needles, embers, a light,
//     and THE HURT ZONE drawn on the floor (a wave that stops at TOD_DOPPEL_DEATH_RADIUS, a
//     glowing edge ring there). The stock gore burst still plays over it.
//   * THE JUKE: a dark smear + red sparks along the dodge (the BO6 clip's frame-11 effect).
//   * THE CLAW: a red-hot glow and ribbon on the swiping claw for the swing's own effect
//     window (stn_melee_01 frames 2-22) - the windup's visual tell.
//   * THE MANGLER BREAKS UP: sparks, steam, scrap and smoke at its torso as its death clip
//     ends; the body hides under the flash (it used to vanish at 3 s with nothing).
//
// The effects are GENERATED by tools/fxgen/elites/make_fx.py (share/raw/fx/tod/elites); it
// READS the TOD_ELITE_FX_* timing defines below, so a time changed here is a re-run there
// (its --check gate fails until then). Gate: tools/fxgen/elites/test_elite_fx.js.
//
// THE LANE: server tag_origin carriers (a bare server PlayFX does not render here, and
// nothing is played ON an actor). World one-shots go through the one owner,
// tod_ability_fx::burst_at. The carriers that move are this module's: the death charge
// follows the corpse's torso (moved each server frame by _tod_doppelghast's own torso
// loop - a ragdoll is client-only, so nothing is linked to the body); the juke and the
// claw are LINKED to a bone of the living actor (the Mangler's body_lights precedent) and
// die on its death, on a world pause, or at their deadline. Every carrier deletes itself.
//
// COST: at most TOD_ELITE_FX_LINKED_MAX juke / claw carriers alive map-wide (a co-op haven
// fight can field five elites swinging at once); past it a swing or a juke plays no
// effect (logged). The death effects are never capped (the charge is the blast's tell).
//
// LOGS [TOD_ELITE_FX] (dev / diag, console only): INIT, CHARGE start / end, BLAST, JUKE /
// CLAW (with their end reason), MANGLER, DROPPED (cap / missing tag / entity pool) - the
// first TOD_ELITE_FX_LOG_EVENTS of each kind, so a long run never floods the console.
// =============================================================================
#using scripts\zm\zm_tod2_cybercity\_tod_ability_fx;   // burst_at: the one owner of world one-shots

#insert scripts\shared\shared.gsh;

#precache( "fx", "tod/elites/fx_tod_doppel_death_charge" );
#precache( "fx", "tod/elites/fx_tod_doppel_death_blast" );
#precache( "fx", "tod/elites/fx_tod_doppel_juke" );
#precache( "fx", "tod/elites/fx_tod_doppel_claw" );
#precache( "fx", "tod/elites/fx_tod_mangler_death" );

#define TOD_ELITE_FX_CHARGE          "tod/elites/fx_tod_doppel_death_charge"
#define TOD_ELITE_FX_BLAST           "tod/elites/fx_tod_doppel_death_blast"
#define TOD_ELITE_FX_JUKE            "tod/elites/fx_tod_doppel_juke"
#define TOD_ELITE_FX_CLAW            "tod/elites/fx_tod_doppel_claw"
#define TOD_ELITE_FX_MANGLER         "tod/elites/fx_tod_mangler_death"
// THE CLOCK (LOCKSTEP: tools/fxgen/elites/make_fx.py reads every one of these)
#define TOD_ELITE_FX_CHARGE_MS       2900    // the build-up: the squib (+0.1 s) to the blast (+3.0 s = dth_01 frame 90) in _tod_doppelghast::death_burst
#define TOD_ELITE_FX_BLAST_SECS      2.5     // the blast carrier's life (its charcoal puff is the last to go)
#define TOD_ELITE_FX_JUKE_ON_MS      300     // the smear starts at the juke clip's frame 11 (0.37 s), less the carrier's one-frame wait
#define TOD_ELITE_FX_JUKE_SECS       1.3     // the juke carrier's life (the clip is 39-40 frames; the smear fades by ~1.25 s)
#define TOD_ELITE_FX_CLAW_SECS       0.75    // stn_melee_01's own effect window: FxOnObject frames 2..22 at 30 fps
#define TOD_ELITE_FX_CLAW_TAG        "bone_9f4f9c2253737e9b"   // the swiping claw: the fastest chain off j_clavicle_ri in stn_melee_01 (60 u ahead at frame 13; measured)
#define TOD_ELITE_FX_MANGLER_SECS    3.4     // the Mangler burst carrier's life (its smoke is the last to go)
#define TOD_ELITE_FX_UP              ( -90, 0, 0 )   // the impact frame: the effect's +X = up (the Rune Prison's burst_at angles)
#define TOD_ELITE_FX_LINKED_MAX      6       // juke / claw carriers alive at once, map-wide
#define TOD_ELITE_FX_FLOOR_PROBE     96      // how far under the torso the blast looks for the floor
#define TOD_ELITE_FX_LOG_EVENTS      12      // log lines per kind before going quiet
#define TOD_ELITE_FX_SOUND_LIFE      5       // a cue's script_origin lives this long
#define TOD_ELITE_FX_CHARGE_ALIAS    "tod_elite_doppel_charge"   // sound/aliases/tod_elite_fx.csv: the rising whine under the charge

#namespace tod_elite_fx;

function dev_log( msg )
{
	if ( !( IS_TRUE( level.tod_dev ) || IS_TRUE( level.tod_diag ) ) )
		return;
	line = "[TOD_ELITE_FX] ms=" + GetTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}

function ensure()
{
	if ( isdefined( level.tod_elite_fx_live ) )
		return;
	level.tod_elite_fx_live = 0;
	level.tod_elite_fx_counts = [];
	dev_log( "INIT rev=1 linked_max=" + TOD_ELITE_FX_LINKED_MAX + " charge_ms=" + TOD_ELITE_FX_CHARGE_MS + " claw_tag=" + TOD_ELITE_FX_CLAW_TAG );
}

// a caller's generation for a log line (an undefined one would break the string concatenation - a script error)
function gen( generation )
{
	if ( !isdefined( generation ) )
		return -1;
	return generation;
}

// count one event of `kind`; true while it is among the first TOD_ELITE_FX_LOG_EVENTS (its line prints)
function tally( kind )
{
	ensure();
	n = level.tod_elite_fx_counts[ kind ];
	if ( !isdefined( n ) )
		n = 0;
	level.tod_elite_fx_counts[ kind ] = n + 1;
	return ( n < TOD_ELITE_FX_LOG_EVENTS );
}

// =============================================================================
// THE DOPPELGHAST'S DEATH
// =============================================================================
// THE CHARGE begins (the squib's moment): a carrier at the torso playing the build-up, and the whine.
// The caller moves it with charge_follow and ends it at the blast (charge_end). -> the carrier or undefined.
function charge_start( org, generation )
{
	ensure();
	generation = gen( generation );
	sound_at( TOD_ELITE_FX_CHARGE_ALIAS, org );
	host = Spawn( "script_model", org );
	if ( !isdefined( host ) )
	{
		dev_log( "DROPPED kind=charge reason=entity_pool generation=" + generation );
		return undefined;
	}
	host SetModel( "tag_origin" );
	host.angles = TOD_ELITE_FX_UP;
	host thread carrier_play( TOD_ELITE_FX_CHARGE );
	host thread carrier_failsafe( TOD_ELITE_FX_CHARGE_MS * 0.001 + 1.0 );
	if ( tally( "charge" ) )
		dev_log( "CHARGE phase=start generation=" + generation + " host=" + host GetEntityNumber() + " at=" + org + " ms=" + TOD_ELITE_FX_CHARGE_MS );
	return host;
}

// the torso moved: the charge goes with it (one server frame's glide, so the client sees no snap)
function charge_follow( host, org )
{
	if ( !isdefined( host ) || !isdefined( org ) )
		return;
	if ( DistanceSquared( host.origin, org ) < 0.25 )
		return;
	host MoveTo( org, 0.05 );
}

function charge_end( host, generation )
{
	if ( !isdefined( host ) )
		return;
	generation = gen( generation );
	if ( tally( "charge_end" ) )
		dev_log( "CHARGE phase=end generation=" + generation + " host=" + host GetEntityNumber() + " at=" + host.origin );
	host Delete();
}

// THE BLAST: on the floor under the torso, so the hurt zone's ring lies on it (the impact frame: +X up).
// ignore = the corpse (the floor trace must not stop on it).
function blast( org, ignore, generation )
{
	ensure();
	generation = gen( generation );
	if ( !isdefined( org ) )
		return;
	floor = floor_under( org, ignore );
	tod_ability_fx::burst_at( TOD_ELITE_FX_BLAST, floor, TOD_ELITE_FX_UP, TOD_ELITE_FX_BLAST_SECS );
	if ( tally( "blast" ) )
		dev_log( "BLAST generation=" + generation + " torso=" + org + " floor=" + floor + " drop=" + ( org[ 2 ] - floor[ 2 ] ) );
}

function floor_under( org, ignore )
{
	tr = BulletTrace( org + ( 0, 0, 4 ), org - ( 0, 0, TOD_ELITE_FX_FLOOR_PROBE ), false, ignore );
	if ( isdefined( tr ) && isdefined( tr[ "fraction" ] ) && tr[ "fraction" ] < 1 )
		return tr[ "position" ] + ( 0, 0, 1 );
	return org - ( 0, 0, 16 );   // no floor in reach (a ledge): the ring sits under the body anyway
}

// =============================================================================
// THE DOPPELGHAST ALIVE: the juke smear and the claw
// =============================================================================
// THE JUKE: call it the moment the juke clip starts (a one-shot timeline: the smear itself starts at the clip's frame 11).
function juke( actor )
{
	return linked( actor, "j_spine4", TOD_ELITE_FX_JUKE, TOD_ELITE_FX_JUKE_SECS, "juke" );
}

// THE CLAW: call it the moment the swipe clip starts; the glow lives the swing's own effect window.
function claw( actor )
{
	return linked( actor, TOD_ELITE_FX_CLAW_TAG, TOD_ELITE_FX_CLAW, TOD_ELITE_FX_CLAW_SECS, "claw" );
}

// a carrier linked to `tag` of a living actor, playing `effect`; it dies at `secs`, on the actor's death or a world
// pause. -> the carrier or undefined (the cap, a missing bone or a full entity pool: the moment plays no effect)
function linked( actor, tag, effect, secs, kind )
{
	ensure();
	if ( !isdefined( actor ) || !IsAlive( actor ) || IS_TRUE( level.tod_upgrade_pause ) )
		return undefined;
	if ( level.tod_elite_fx_live >= TOD_ELITE_FX_LINKED_MAX )
	{
		if ( tally( "dropped_cap" ) )
			dev_log( "DROPPED kind=" + kind + " reason=cap live=" + level.tod_elite_fx_live + " max=" + TOD_ELITE_FX_LINKED_MAX );
		return undefined;
	}
	org = actor GetTagOrigin( tag );
	if ( !isdefined( org ) )
	{
		if ( tally( "dropped_tag" ) )
			dev_log( "DROPPED kind=" + kind + " reason=missing_tag tag=" + tag + " actor=" + actor GetEntityNumber() + " model=" + actor.model );
		return undefined;
	}
	host = Spawn( "script_model", org );
	if ( !isdefined( host ) )
	{
		if ( tally( "dropped_pool" ) )
			dev_log( "DROPPED kind=" + kind + " reason=entity_pool" );
		return undefined;
	}
	host SetModel( "tag_origin" );
	host LinkTo( actor, tag, ( 0, 0, 0 ), ( 0, 0, 0 ) );
	level.tod_elite_fx_live++;
	host thread carrier_play( effect );
	level thread linked_watch( host, actor, secs, kind );
	if ( tally( kind ) )
		dev_log( "LINK kind=" + kind + " actor=" + actor GetEntityNumber() + " host=" + host GetEntityNumber() + " tag=" + tag + " secs=" + secs + " live=" + level.tod_elite_fx_live );
	return host;
}

// level-owned, so the live count is given back even if something else deletes the carrier first
function linked_watch( host, actor, secs, kind )
{
	level endon( "end_game" );
	deadline = GetTime() + Int( secs * 1000 );
	why = "done";
	while ( GetTime() < deadline )
	{
		wait 0.05;
		if ( !isdefined( host ) )
		{
			why = "carrier_gone";
			break;
		}
		if ( !isdefined( actor ) || !IsAlive( actor ) )
		{
			why = "death";
			break;
		}
		if ( IS_TRUE( level.tod_upgrade_pause ) )
		{
			why = "pause";
			break;
		}
	}
	level.tod_elite_fx_live--;
	if ( level.tod_elite_fx_live < 0 )
		level.tod_elite_fx_live = 0;
	if ( isdefined( host ) )
		host Delete();
	if ( why != "done" && tally( kind + "_cut" ) )
		dev_log( "CUT kind=" + kind + " why=" + why + " live=" + level.tod_elite_fx_live );
}

// =============================================================================
// THE MANGLER BREAKS UP (at its torso as the death clip ends; the impact frame: +X up)
// =============================================================================
function mangler_burst( org, generation )
{
	ensure();
	generation = gen( generation );
	if ( !isdefined( org ) )
		return;
	tod_ability_fx::burst_at( TOD_ELITE_FX_MANGLER, org, TOD_ELITE_FX_UP, TOD_ELITE_FX_MANGLER_SECS );
	if ( tally( "mangler" ) )
		dev_log( "MANGLER generation=" + generation + " at=" + org );
}

// =============================================================================
// helpers
// =============================================================================
function carrier_play( effect )   // self = the carrier
{
	self endon( "death" );
	wait 0.05;   // one frame: the client resolves the new entity's tag_origin before its effect
	PlayFXOnTag( effect, self, "tag_origin" );
}

function carrier_failsafe( secs )   // self = the carrier
{
	self endon( "death" );
	wait secs;
	if ( isdefined( self ) )
		self Delete();
}

// a custom 3D cue at a point: a script_origin's PlaySound (PlaySoundAtPosition is silent for a custom alias here)
function sound_at( alias, org )
{
	e = Spawn( "script_origin", org );
	if ( !isdefined( e ) )
	{
		dev_log( "SOUND_DROPPED alias=" + alias + " reason=entity_pool" );
		return;
	}
	e PlaySound( alias );
	e thread carrier_failsafe( TOD_ELITE_FX_SOUND_LIFE );
}
