// =============================================================================
// _tod_war_sky.csc - THE WAR DAMAGE PASS, phase 2 (docs/205 s7): THE WAR IN THE SKY.
//
// User 2026-10-03: "The map is basically the first map but looks like its been fallen and beaten up by wars."
// The war is not over out there. Far over the city's horizon, in every direction but the sign's:
//   * DETONATIONS: a hot flash that snaps on and dies, a warm halo lingering, a smoke knot (three sizes); its boom
//     arrives LATE, by the distance (the speed of sound), from the flash's own point; sometimes a barrage of them;
//   * EXCHANGES: a far gun rattling off a burst of tracers at something a few thousand units over (cyan plasma
//     or orange), some rounds landing in a small flash; sometimes the other side answers in the other colour;
//   * A STRICKEN SHIP: now and then one of the fleet's own haulers or gunships falls out of the sky far away -
//     flown as a scaled stand-in inside the sealed box exactly like the fleet (tod_sky_ships::stand_in, its
//     nozzle flames through the fleet's own engine logic), fire and black smoke pouring off it, a secondary
//     explosion on the way down, and the impact beyond the horizon: a fireball, a rising column, a late boom.
// CLIENT ONLY: no server entity, no clientfield; the wreck is the one client entity, counted in the fleet's own
// budget (tod_sky_ships::ents_add / ents_free). THE SIGN'S SKY STAYS CLEAN: nothing plays within
// TOD_WAR_SKY_SIGN_KEEP degrees of the sign's bearing below TOD_WAR_SKY_SIGN_EL, and the whole war HOLDS through
// a player's first-jump scene (tod_jump_title_start .. tod_jump_title_end + TOD_WAR_SKY_HOLD_AFTER; a wreck
// near the sign at the scene's start is removed before the camera arrives there).
// Effects GENERATED by tools/war_damage/make_fx.py; sounds by make_sounds.py.
// Logs: [TOD_WAR_SKY] READY / FLASH / BARRAGE / EXCHANGE / WRECK / WRECK_END / HOLD / RESUME / NO_SITE / BUDGET.
// =============================================================================

#using scripts\shared\callbacks_shared;
#using scripts\shared\system_shared;
#using scripts\shared\util_shared;

#using scripts\zm\zm_tod2_cybercity\_tod_sky_lanes;
#using scripts\zm\zm_tod2_cybercity\_tod_sky_ships;

#insert scripts\shared\shared.gsh;

#namespace tod_war_sky;

#define TOD_WAR_SKY_ENABLED    1
#define TOD_WAR_SKY_LOG        1        // [TOD_WAR_SKY] records; 0 before a publish
#define TOD_WAR_SKY_REV        1
#define TOD_WAR_SKY_FIRST_MIN  14       // s after a client connects before the first event
#define TOD_WAR_SKY_FIRST_MAX  32
#define TOD_WAR_SKY_GAP_MIN    7        // s between events
#define TOD_WAR_SKY_GAP_MAX    19
#define TOD_WAR_SKY_EL_MIN     2        // a flash sits this low over the city's horizon (degrees) ...
#define TOD_WAR_SKY_EL_MAX     13       // ... to this high
#define TOD_WAR_SKY_R_MIN      7000     // drawn no nearer than this (the war is FAR; the sealed box ends at ~11,800)
#define TOD_WAR_SKY_R_MAX      11600
#define TOD_WAR_SKY_SIGN_YAW   180      // LOCKSTEP _tod_jump_title.csc TOD_JT_SIGN_YAW (the sky's sign bearing)
#define TOD_WAR_SKY_SIGN_KEEP  38       // no war within this many degrees of the sign's bearing ...
#define TOD_WAR_SKY_SIGN_EL    30       // ... below this elevation
#define TOD_WAR_SKY_SOUND_U_S  13500    // the speed of sound in units/s (343 m/s x 39.37 u/m): a far boom arrives late
#define TOD_WAR_SKY_FAR_MULT   2.4      // the drawn point stands for something this much further away (the delay sells it)
#define TOD_WAR_SKY_HOLD_AFTER 3.0      // s after the first-jump scene's end beat before the war resumes
#define TOD_WAR_SKY_HOLD_MAX   20       // s a hold may last without its end beat (a safety)
#define TOD_WAR_SKY_WRECK_FIRST_MIN 50
#define TOD_WAR_SKY_WRECK_FIRST_MAX 130
#define TOD_WAR_SKY_WRECK_GAP_MIN 110   // s between stricken ships
#define TOD_WAR_SKY_WRECK_GAP_MAX 240
#define TOD_WAR_SKY_WRECK_SECS_MIN 15   // s a stricken ship takes to fall out of the sky
#define TOD_WAR_SKY_WRECK_SECS_MAX 24
#define TOD_WAR_SKY_WRECK_D_MIN 26000   // its true distance (drawn as a scaled stand-in inside the box)
#define TOD_WAR_SKY_WRECK_D_MAX 40000
#define TOD_WAR_SKY_WRECK_EL_MIN 20     // where it starts (degrees up) ...
#define TOD_WAR_SKY_WRECK_EL_MAX 38
#define TOD_WAR_SKY_WRECK_END_EL 1.5    // ... and where it hits: just over the horizon, the city
#define TOD_WAR_SKY_WRECK_TRAIL_L 1800  // a drawn ship this long or longer trails the large fire
#define TOD_WAR_SKY_TICK       0.1

#precache( "client_fx", "tod/war/fx_war_sky_flash_s" );
#precache( "client_fx", "tod/war/fx_war_sky_flash_m" );
#precache( "client_fx", "tod/war/fx_war_sky_flash_l" );
#precache( "client_fx", "tod/war/fx_war_sky_tracer_c" );
#precache( "client_fx", "tod/war/fx_war_sky_tracer_o" );
#precache( "client_fx", "tod/war/fx_war_sky_hit" );
#precache( "client_fx", "tod/war/fx_war_sky_wreck_s" );
#precache( "client_fx", "tod/war/fx_war_sky_wreck_l" );
#precache( "client_fx", "tod/war/fx_war_sky_impact" );

REGISTER_SYSTEM( "tod_war_sky", &__init__, undefined )

function __init__()
{
	if ( !TOD_WAR_SKY_ENABLED )
		return;
	level.tod_war_sky_hold = [];
	level.tod_war_sky_wreck = [];
	level.tod_war_sky_serial = 0;
	callback::on_localclient_connect( &on_local_connect );
	level thread hold_watch( "tod_jump_title_start", true );
	level thread hold_watch( "tod_jump_title_end", false );
}

function on_local_connect( localClientNum )
{
	level.tod_war_sky_hold[ localClientNum ] = false;
	level thread war_loop( localClientNum );
	level thread wreck_loop( localClientNum );
	log( "READY rev=" + TOD_WAR_SKY_REV + " client=" + localClientNum + " gap=" + TOD_WAR_SKY_GAP_MIN + ".." + TOD_WAR_SKY_GAP_MAX
		+ " el=" + TOD_WAR_SKY_EL_MIN + ".." + TOD_WAR_SKY_EL_MAX + " r=" + TOD_WAR_SKY_R_MIN + ".." + TOD_WAR_SKY_R_MAX
		+ " sign_keep=" + TOD_WAR_SKY_SIGN_KEEP + "deg@" + TOD_WAR_SKY_SIGN_YAW + " wreck_gap=" + TOD_WAR_SKY_WRECK_GAP_MIN + ".." + TOD_WAR_SKY_WRECK_GAP_MAX );
}

// ---- the first-jump scene: hold everything from its start beat to its end beat (+ a little) ---------------------------
function hold_watch( beat, hold )
{
	while ( true )
	{
		level waittill( beat, localClientNum );
		if ( !isdefined( localClientNum ) )
			localClientNum = 0;
		if ( hold )
		{
			level.tod_war_sky_hold[ localClientNum ] = true;
			level notify( "tod_war_sky_hold_" + localClientNum );
			level thread hold_timeout( localClientNum );
			log( "HOLD client=" + localClientNum + " why=" + beat );
			continue;
		}
		level thread release_later( localClientNum, TOD_WAR_SKY_HOLD_AFTER, beat );
	}
}

function hold_timeout( localClientNum )
{
	level endon( "tod_war_sky_hold_" + localClientNum );
	level endon( "tod_war_sky_release_" + localClientNum );
	waitrealtime( TOD_WAR_SKY_HOLD_MAX );
	if ( IS_TRUE( level.tod_war_sky_hold[ localClientNum ] ) )
	{
		level.tod_war_sky_hold[ localClientNum ] = false;
		log( "RESUME client=" + localClientNum + " why=timeout" );
	}
}

function release_later( localClientNum, secs, why )
{
	level endon( "tod_war_sky_hold_" + localClientNum );
	waitrealtime( secs );
	level notify( "tod_war_sky_release_" + localClientNum );
	level.tod_war_sky_hold[ localClientNum ] = false;
	log( "RESUME client=" + localClientNum + " why=" + why );
}

function held( localClientNum )
{
	return IS_TRUE( level.tod_war_sky_hold[ localClientNum ] );
}

// ---- geometry -----------------------------------------------------------------------------------------------------------
function near_sign( yaw, el )
{
	if ( el > TOD_WAR_SKY_SIGN_EL )
		return false;
	d = yaw - TOD_WAR_SKY_SIGN_YAW;
	while ( d > 180 ) d -= 360;
	while ( d < -180 ) d += 360;
	return Abs( d ) < TOD_WAR_SKY_SIGN_KEEP;
}

function near_sign_v( v )
{
	a = VectorToAngles( v );
	return near_sign( a[ 1 ], 0 - a[ 0 ] );
}

// -> array( point, direction, drawn distance ) or undefined: a far point in the band el_min..el_max, inside the sealed
// box, clear of the crown / arena blockers and of the sign's sky.
function site( cam, el_min, el_max, r_min )
{
	for ( i = 0; i < 12; i++ )
	{
		yaw = RandomFloatRange( 0, 360 );
		el = RandomFloatRange( el_min, el_max );
		if ( near_sign( yaw, el ) )
			continue;
		d = tod_sky_ships::dir_ye( yaw, el );
		// the drawn distance is PICKED in r_min..R_MAX, then clamped by the sealed box. The box reach alone put every
		// site at R_MAX (the user's first run, 2026-10-03 15:45: all 24 sites at 11,252, every boom exactly 2.0 s late)
		r = tod_sky_ships::fmin( tod_sky_ships::box_reach( cam, d, 300 ), RandomFloatRange( r_min, TOD_WAR_SKY_R_MAX ) );
		if ( r < r_min )
			continue;
		p = cam + d * ( r * 0.97 );
		if ( tod_sky_ships::in_blocker( p ) )
			continue;
		return array( p, d, r * 0.97 );
	}
	return undefined;
}

function sound_delay( r )
{
	return r * TOD_WAR_SKY_FAR_MULT / TOD_WAR_SKY_SOUND_U_S;
}

function boom_later( localClientNum, alias, p, r )
{
	waitrealtime( sound_delay( r ) );
	PlaySound( localClientNum, alias, p );
}

// a detonation: size 0 / 1 / 2 = s / m / l, its boom late by the distance
function flash( localClientNum, size, p, r )
{
	fx = "tod/war/fx_war_sky_flash_s";
	alias = "tod_war_far_boom_a";
	if ( size == 1 )
	{
		fx = "tod/war/fx_war_sky_flash_m";
		alias = "tod_war_far_boom_b";
	}
	else if ( size >= 2 )
	{
		fx = "tod/war/fx_war_sky_flash_l";
		alias = "tod_war_far_boom_c";
	}
	PlayFX( localClientNum, fx, p, ( 0, 0, 1 ), ( 1, 0, 0 ) );
	level thread boom_later( localClientNum, alias, p, r );
}

// ---- the events ---------------------------------------------------------------------------------------------------------
function war_loop( localClientNum )
{
	level endon( "tod_sky_stop" );
	waitrealtime( RandomFloatRange( TOD_WAR_SKY_FIRST_MIN, TOD_WAR_SKY_FIRST_MAX ) );
	while ( true )
	{
		if ( !held( localClientNum ) )
		{
			roll = RandomInt( 100 );
			if ( roll < 55 )
				event_flash( localClientNum );
			else if ( roll < 85 )
				event_exchange( localClientNum );
			else
				event_barrage( localClientNum );
		}
		waitrealtime( RandomFloatRange( TOD_WAR_SKY_GAP_MIN, TOD_WAR_SKY_GAP_MAX ) );
	}
}

function event_flash( localClientNum )
{
	cam = GetCamPosByLocalClientNum( localClientNum );
	st = site( cam, TOD_WAR_SKY_EL_MIN, TOD_WAR_SKY_EL_MAX, TOD_WAR_SKY_R_MIN );
	if ( !isdefined( st ) )
	{
		log( "NO_SITE client=" + localClientNum + " what=flash cam=" + cam );
		return;
	}
	size = 0;
	roll = RandomInt( 100 );
	if ( roll >= 50 ) size = 1;
	if ( roll >= 85 ) size = 2;
	flash( localClientNum, size, st[ 0 ], st[ 2 ] );
	log( "FLASH client=" + localClientNum + " size=" + size + " at=" + st[ 0 ] + " dist=" + int( st[ 2 ] ) + " boom_in=" + sound_delay( st[ 2 ] ) );
}

function event_barrage( localClientNum )
{
	cam = GetCamPosByLocalClientNum( localClientNum );
	st = site( cam, TOD_WAR_SKY_EL_MIN, TOD_WAR_SKY_EL_MAX, TOD_WAR_SKY_R_MIN );
	if ( !isdefined( st ) )
	{
		log( "NO_SITE client=" + localClientNum + " what=barrage cam=" + cam );
		return;
	}
	right = tod_sky_ships::vnorm( tod_sky_ships::vcross( st[ 1 ], ( 0, 0, 1 ) ) );
	upv = tod_sky_ships::vcross( right, st[ 1 ] );
	n = RandomIntRange( 3, 6 );
	fired = 0;
	for ( i = 0; i < n; i++ )
	{
		p = st[ 0 ] + right * RandomFloatRange( -900, 900 ) + upv * RandomFloatRange( -150, 350 );
		if ( !tod_sky_ships::in_blocker( p ) )
		{
			flash( localClientNum, RandomInt( 2 ), p, st[ 2 ] );
			fired++;
		}
		waitrealtime( RandomFloatRange( 0.25, 0.9 ) );
		if ( held( localClientNum ) )
			break;
	}
	log( "BARRAGE client=" + localClientNum + " flashes=" + fired + "/" + n + " at=" + st[ 0 ] + " dist=" + int( st[ 2 ] ) );
}

function guns_later( localClientNum, p, r )
{
	waitrealtime( sound_delay( r ) );
	alias = "tod_war_far_guns_a";
	if ( RandomInt( 2 ) )
		alias = "tod_war_far_guns_b";
	PlaySound( localClientNum, alias, p );
}

function hit_later( localClientNum, p, secs )
{
	waitrealtime( secs );
	PlayFX( localClientNum, "tod/war/fx_war_sky_hit", p, ( 0, 0, 1 ), ( 1, 0, 0 ) );
}

// a burst of tracers from a to b (n rounds, the colour's effect), some landing in a hit at b
function volley( localClientNum, a, b, right, upv, n, fx, r )
{
	span = b - a;
	len = Length( span );
	dir = span * ( 1.0 / tod_sky_ships::fmax( len, 1 ) );
	speed = 4200;                                                    // LOCKSTEP make_fx.py TRACER speed
	level thread guns_later( localClientNum, a, r );
	for ( i = 0; i < n; i++ )
	{
		jit = right * RandomFloatRange( -70, 70 ) + upv * RandomFloatRange( -70, 70 );
		PlayFX( localClientNum, fx, a + jit, tod_sky_ships::vnorm( dir + jit * 0.00006 ), upv );
		if ( RandomInt( 100 ) < 30 )
			level thread hit_later( localClientNum, b + jit * 1.5, len / speed );
		waitrealtime( RandomFloatRange( 0.08, 0.2 ) );
		if ( held( localClientNum ) )
			return i + 1;
	}
	return n;
}

function event_exchange( localClientNum )
{
	cam = GetCamPosByLocalClientNum( localClientNum );
	st = site( cam, TOD_WAR_SKY_EL_MIN, 9, TOD_WAR_SKY_R_MIN );
	if ( !isdefined( st ) )
	{
		log( "NO_SITE client=" + localClientNum + " what=exchange cam=" + cam );
		return;
	}
	a = st[ 0 ];
	right = tod_sky_ships::vnorm( tod_sky_ships::vcross( st[ 1 ], ( 0, 0, 1 ) ) );
	upv = tod_sky_ships::vcross( right, st[ 1 ] );
	side = 1;
	if ( RandomInt( 2 ) )
		side = -1;
	b = a + right * ( side * RandomFloatRange( 1100, 2400 ) ) + upv * RandomFloatRange( -150, 500 );
	span = b - a;
	len = Length( span );
	if ( tod_sky_ships::box_reach( a, span * ( 1.0 / len ), 300 ) < len || tod_sky_ships::in_blocker( b ) )
	{
		log( "NO_SITE client=" + localClientNum + " what=exchange_target cam=" + cam );
		return;
	}
	fx = "tod/war/fx_war_sky_tracer_c";
	reply = "tod/war/fx_war_sky_tracer_o";
	if ( RandomInt( 2 ) )
	{
		fx = "tod/war/fx_war_sky_tracer_o";
		reply = "tod/war/fx_war_sky_tracer_c";
	}
	n = volley( localClientNum, a, b, right, upv, RandomIntRange( 6, 13 ), fx, st[ 2 ] );
	n2 = 0;
	if ( !held( localClientNum ) && RandomInt( 100 ) < 45 )
	{
		waitrealtime( RandomFloatRange( 0.4, 1.2 ) );
		if ( !held( localClientNum ) )
			n2 = volley( localClientNum, b, a, right, upv, RandomIntRange( 4, 9 ), reply, st[ 2 ] );
	}
	log( "EXCHANGE client=" + localClientNum + " from=" + a + " to=" + b + " rounds=" + n + " reply=" + n2 + " dist=" + int( st[ 2 ] ) + " span=" + int( len ) );
}

// ---- the stricken ship --------------------------------------------------------------------------------------------------
function wreck_loop( localClientNum )
{
	level endon( "tod_sky_stop" );
	waitrealtime( RandomFloatRange( TOD_WAR_SKY_WRECK_FIRST_MIN, TOD_WAR_SKY_WRECK_FIRST_MAX ) );
	while ( true )
	{
		if ( !held( localClientNum ) && !isdefined( level.tod_war_sky_wreck[ localClientNum ] ) )
			level thread wreck( localClientNum );
		waitrealtime( RandomFloatRange( TOD_WAR_SKY_WRECK_GAP_MIN, TOD_WAR_SKY_WRECK_GAP_MAX ) );
	}
}

function wreck( localClientNum )
{
	level endon( "tod_sky_stop" );
	player = GetLocalPlayer( localClientNum );
	if ( !isdefined( player ) || !isdefined( level.tod_sky_classes ) )
		return;
	name = "hauler";
	if ( RandomInt( 100 ) < 45 )
		name = "gunship";
	def = level.tod_sky_classes[ name ];
	if ( !isdefined( def ) )
		return;
	if ( !tod_sky_ships::ents_free( localClientNum, 1 ) )
	{
		log( "BUDGET client=" + localClientNum + " what=wreck" );
		return;
	}
	cam = GetCamPosByLocalClientNum( localClientNum );
	// the true path: far and high, down to just over the horizon (the city beyond it), clear of the sign's sky
	p0 = undefined;
	p1 = undefined;
	for ( i = 0; i < 10 && !isdefined( p1 ); i++ )
	{
		yaw0 = RandomFloatRange( 0, 360 );
		el0 = RandomFloatRange( TOD_WAR_SKY_WRECK_EL_MIN, TOD_WAR_SKY_WRECK_EL_MAX );
		yaw1 = yaw0 + RandomFloatRange( -28, 28 );
		if ( near_sign( yaw0, el0 ) || near_sign( yaw1, TOD_WAR_SKY_WRECK_END_EL ) || near_sign( ( yaw0 + yaw1 ) * 0.5, el0 * 0.5 ) )
			continue;
		dist = RandomFloatRange( TOD_WAR_SKY_WRECK_D_MIN, TOD_WAR_SKY_WRECK_D_MAX );
		p0 = cam + tod_sky_ships::dir_ye( yaw0, el0 ) * dist;
		p1 = cam + tod_sky_ships::dir_ye( yaw1, TOD_WAR_SKY_WRECK_END_EL ) * ( dist * RandomFloatRange( 0.85, 1.1 ) );
	}
	if ( !isdefined( p1 ) )
	{
		log( "NO_SITE client=" + localClientNum + " what=wreck cam=" + cam );
		return;
	}
	secs = RandomFloatRange( TOD_WAR_SKY_WRECK_SECS_MIN, TOD_WAR_SKY_WRECK_SECS_MAX );
	level.tod_war_sky_serial++;
	serial = level.tod_war_sky_serial;
	level.tod_war_sky_wreck[ localClientNum ] = serial;
	base = VectorToAngles( tod_sky_ships::vnorm( p1 - p0 ) );
	roll0 = RandomFloatRange( -25, 25 );
	roll_rate = RandomFloatRange( -9, 9 );
	pose = ( base[ 0 ] + 8, base[ 1 ], roll0 );                        // the nose a little further down than its path
	si = tod_sky_ships::stand_in( def, p0, pose, cam );
	w = spawn( localClientNum, si[ 0 ], "script_model" );
	if ( !isdefined( w ) )
	{
		level.tod_war_sky_wreck[ localClientNum ] = undefined;
		return;
	}
	model = def.models[ RandomInt( def.models.size ) ];
	w.angles = pose;
	w SetModel( model );
	w SetScale( si[ 1 ] );
	if ( si[ 2 ] )
		w Hide();
	shown = !si[ 2 ];
	w.tod_sky_k = si[ 1 ];
	w.tod_sky_nzk = [];
	w.tod_sky_nzb = [];
	w.tod_sky_nzf = [];
	w.tod_sky_swaps = 0;
	w.tod_sky_dobj = false;
	for ( j = 0; j < def.nozzles.size; j++ )
	{
		w.tod_sky_nzk[ j ] = "";
		w.tod_sky_nzb[ j ] = -1;
	}
	tod_sky_ships::ents_add( localClientNum, 1 );
	w util::waittill_dobj( localClientNum );
	if ( !isdefined( w ) )
	{
		tod_sky_ships::ents_add( localClientNum, -1 );
		level.tod_war_sky_wreck[ localClientNum ] = undefined;
		return;
	}
	w.tod_sky_dobj = true;
	trail = "tod/war/fx_war_sky_wreck_s";
	if ( si[ 1 ] * ( def.front + def.back ) >= TOD_WAR_SKY_WRECK_TRAIL_L )
		trail = "tod/war/fx_war_sky_wreck_l";
	tfx = PlayFXOnTag( localClientNum, trail, w, "tag_origin" );
	log( "WRECK n=" + serial + " client=" + localClientNum + " ship=" + name + " model=" + model + " from=" + p0 + " to=" + p1 + " secs=" + secs
		+ " dist=" + int( Length( p0 - cam ) ) + " k=" + si[ 1 ] + " hidden=" + si[ 2 ] + " trail=" + trail + " cam=" + cam );
	last = GetRealTime();
	t = 0;
	boom_at = RandomFloatRange( 0.35, 0.65 );
	boomed = false;
	aborted = false;
	while ( t < secs )
	{
		waitrealtime( TOD_WAR_SKY_TICK );
		dt = tod_sky_ships::rt_step( last );
		last = GetRealTime();
		t += dt;
		if ( !isdefined( w ) )
			break;
		s = tod_sky_ships::fclamp( t / secs, 0, 1 );
		ss = s * s * 0.35 + s * 0.65;                                 // it gathers speed as it falls
		pos = p0 + ( p1 - p0 ) * ss;
		pose = ( base[ 0 ] + 8 + 14 * ss, base[ 1 ] + 6 * Sin( t * 40 ), roll0 + roll_rate * t );
		cam = GetCamPosByLocalClientNum( localClientNum );
		if ( held( localClientNum ) && near_sign_v( pos - cam ) )
		{
			aborted = true;                                            // the scene's camera is about to look there
			break;
		}
		si = tod_sky_ships::stand_in( def, pos, pose, cam );
		w.origin = si[ 0 ];
		w.angles = pose;
		if ( Abs( si[ 1 ] - w.tod_sky_k ) > 0.01 * w.tod_sky_k )
		{
			w SetScale( si[ 1 ] );
			w.tod_sky_k = si[ 1 ];
		}
		if ( si[ 2 ] == shown )
		{
			if ( si[ 2 ] ) w Hide();
			else w Show();
			shown = !si[ 2 ];
		}
		rd = Length( si[ 0 ] - cam );
		tod_sky_ships::engines( localClientNum, def, w, si[ 1 ], rd, shown );
		if ( !isdefined( w ) )
			break;
		if ( !boomed && s >= boom_at )
		{
			boomed = true;                                             // a secondary explosion on the way down
			if ( shown )
				flash( localClientNum, 0, si[ 0 ], rd );
			log( "WRECK_BOOM n=" + serial + " client=" + localClientNum + " t=" + t + " at=" + si[ 0 ] );
		}
	}
	impact = false;
	if ( isdefined( w ) )
	{
		cam = GetCamPosByLocalClientNum( localClientNum );
		si = tod_sky_ships::stand_in( def, p1, pose, cam );
		if ( !aborted && !held( localClientNum ) && !si[ 2 ] )
		{
			rd = Length( si[ 0 ] - cam );
			PlayFX( localClientNum, "tod/war/fx_war_sky_impact", si[ 0 ], ( 0, 0, 1 ), ( 1, 0, 0 ) );
			level thread boom_later( localClientNum, "tod_war_wreck_impact", si[ 0 ], rd );
			impact = true;
		}
		tod_sky_ships::engines_off( localClientNum, w );
		if ( isdefined( tfx ) )
			StopFX( localClientNum, tfx );
		w Delete();
	}
	tod_sky_ships::ents_add( localClientNum, -1 );
	level.tod_war_sky_wreck[ localClientNum ] = undefined;
	log( "WRECK_END n=" + serial + " client=" + localClientNum + " t=" + t + " impact=" + impact + " aborted=" + aborted );
}

function log( msg )
{
	if ( !TOD_WAR_SKY_LOG )
		return;
	line = "[TOD_WAR_SKY] ms=" + GetRealTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}
