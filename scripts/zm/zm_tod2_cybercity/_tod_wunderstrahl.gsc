// =============================================================================
// _tod_wunderstrahl.gsc - THE WUNDERSTRAHL, the laser wonder weapon (docs/219, 2026-10-05).
//
// User: "I want something like a laser. Like a really super strong laser gun ... use the
// Wonder Waffle, but it shoots like a crazy detailed, awesome laser. And it's like an
// automatic laser. So you can hold it down ... a laser down the middle, and then kind of
// swirls that swirl around that laser, with little balls on the swirls". Chosen the same
// day: it SHARES THE GIFT OF DEATH DROP (the Death Machine slot hands out one or the other,
// 50/50, so big-weapon drops are no more common), a yellow core, no overheat, the name.
//
// WHAT THIS FILE OWNS
//   * THE DROP: power-up "tod_wunderstrahl", a gold miniature of the gun. Its gate is the
//     Death Machine's (stock minigun_no_drop: nobody holds a power-up gun, the power / solo
//     rule) plus TOD_WS_DROP_PCT; _tod_powerups::tod_should_drop_minigun carries the same
//     half (TOD_MINIGUN_DROP_PCT, LOCKSTEP) and refuses while anyone holds this gun, so the
//     two share one slot.
//   * THE WINDOW: the stock weapon power-up lane (zm_powerups::weapon_powerup: the class gun
//     goes away and comes back, the gun counts as a drink, the tray row counts down). The
//     countdown pauses while the world or the holder is frozen (a card deal, a Black Market
//     spin) and re-asserts the solo-HUD gate every frame (another window's end clears it).
//     Going down takes the gun through stock's spare Wunderwaffe last-stand hook
//     (level._zombie_tesla_powerup_last_stand_func, read by _zm.gsc beside the minigun's).
//   * THE DAMAGE: the GDT deals none. While the holder IsFiring() with the gun, every
//     TOD_WS_TICK a world trace from the eye finds the wall and every enemy whose body comes
//     within the beam's radius of that segment takes a tick - the beam PIERCES. Ticks are
//     round-independent fractions of max health (horde TOD_WS_HORDE_TICKS, elites
//     TOD_WS_ELITE_TICKS, the Dealer TOD_WS_BOSS_TICKS), stretched by rampage's HP levers;
//     Insta-Kill multiplies the horde tick. _tod_power_scale exempts the weapon by name (the
//     numbers are already a tenth). No damage while the world is paused or the holder flies.
//   * THE KILL: a horde zombie the beam kills bursts into embers (fx_ws_disintegrate) with a
//     zap (tod_ws_kill) and is thrown back along the beam. Elites own their deaths.
// The beam itself is the ENGINE's: the weapon is a gas weapon whose flameBeamFirstPerson /
// ThirdPerson draw from tag_flash (source_data/tod2_wunderstrahl.gdt; beams + effects
// GENERATED by tools/wunderstrahl/fx/make_fx.py; sounds by tools/wunderstrahl/sound/).
//
// LOGS [TOD_WS] (dev, tod_diag, or TOD_WS_LOG): INIT / INIT_FAILED, DROP_ROLL, GRANT, REFILL,
// FIRE_ON lane= / FIRE_OFF ms= ticks= hits= kills=, FALLBACK (IsFiring never reported),
// PAUSE, END reason=, LASTSTAND, KILL (the first TOD_WS_LOG_KILLS of a match).
// Gate: tools/wunderstrahl/test_wunderstrahl.js (the pure functions below run verbatim).
// =============================================================================
#using scripts\codescripts\struct;
#using scripts\shared\callbacks_shared;
#using scripts\shared\laststand_shared;
#using scripts\shared\system_shared;
#using scripts\shared\util_shared;
#using scripts\zm\_zm;
#using scripts\zm\_zm_powerups;
#using scripts\zm\_zm_spawner;
#using scripts\zm\zm_tod2_cybercity\_tod_bosses;          // rampage_hp_mult: the elite HP lever
#using scripts\zm\zm_tod2_cybercity\_tod_zombie_speed;    // rampage_horde_mult: the horde HP lever

#insert scripts\shared\shared.gsh;
#insert scripts\shared\version.gsh;
#insert scripts\zm\_zm_powerups.gsh;

#precache( "model", "tod2_ws_pickup" );
#precache( "model", "tag_origin" );
#precache( "fx", "tod/wunderstrahl/fx_ws_disintegrate" );
#precache( "fx", "tod/wunderstrahl/fx_ws_disintegrate_nl" );
#precache( "fx", "tod/wunderstrahl/fx_ws_zombie_burn" );

#define TOD_WS_WEAPON          "tod2_wunderstrahl"
#define TOD_WS_POWERUP         "tod_wunderstrahl"           // LOCKSTEP the .csc + the tray row (AetheriumPowerupsContainer.lua)
#define TOD_WS_PICKUP_MODEL    "tod2_ws_pickup"
#define TOD_WS_VAR_ON          "zombie_powerup_tod_wunderstrahl_on"     // LOCKSTEP _tod_powerups / _tod_upgrades / _tod_class_terminal
#define TOD_WS_VAR_TIME        "zombie_powerup_tod_wunderstrahl_time"
#define TOD_WS_FX_DIE          "tod/wunderstrahl/fx_ws_disintegrate"      // with its light flash
#define TOD_WS_FX_DIE_NL       "tod/wunderstrahl/fx_ws_disintegrate_nl"   // the same burst without the light
#define TOD_WS_FX_BURN         "tod/wunderstrahl/fx_ws_zombie_burn"
#define TOD_WS_KILL_LIT_PER_SEC 4      // a kill streak: this many lit bursts a second per holder ...
#define TOD_WS_KILL_NL_PER_SEC  8      // ... then this many without the light, then the sound alone (lights + particles stay bounded)
#define TOD_WS_FX_HOST_WAIT    0.1     // two server frames: a fresh host replicates before its effect (CLAUDE.md "Server FX")
#define TOD_WS_SECS            30      // the window (stock N_POWERUP_DEFAULT_TIME, the Gift of Death's)
#define TOD_WS_DROP_PCT        25      // LOCKSTEP _tod_powerups TOD_MINIGUN_DROP_PCT: the two halves of one slot
#define TOD_WS_RANGE           2400    // LOCKSTEP the beam's virtualTargetDistance (tools/wunderstrahl/fx/make_fx.py BEAM_RANGE)
#define TOD_WS_LAUNCH_SPEED    6000    // LOCKSTEP the beam's launchSpeed (make_fx.py BEAM_LAUNCH_SPEED): the reach grows this fast per burst
#define TOD_WS_TICK            0.1
#define TOD_WS_HORDE_TICKS     3       // contact ticks that kill a horde zombie from full (0.3 s), any round
#define TOD_WS_ELITE_TICKS     30      // ... an elite (3 s)
#define TOD_WS_BOSS_TICKS      3000    // ... the Dealer: a whole window held on him is a tenth of him
#define TOD_WS_R_HORDE         16      // the beam's reach around its line, per kind
#define TOD_WS_R_ELITE         26
#define TOD_WS_R_BOSS          34
#define TOD_WS_H_HORDE         64      // the body's height the beam can touch, per kind
#define TOD_WS_H_ELITE         92
#define TOD_WS_H_BOSS          110
#define TOD_WS_FX_GAP_MS       350     // one sizzle per burning body at most this often
#define TOD_WS_FX_PER_SEC      12      // ... and at most this many sizzles a second per holder
#define TOD_WS_FALLBACK_TICKS  5       // the trigger held this many ticks with the gun up and no IsFiring: use the trigger
#define TOD_WS_DIE_LIFE        2.0
#define TOD_WS_BURN_LIFE       1.0
#define TOD_WS_LOG             1       // the user's first run prints [TOD_WS] without dev mode; 0 before publish
#define TOD_WS_LOG_KILLS       20

#namespace tod_wunderstrahl;

REGISTER_SYSTEM( "tod_wunderstrahl", &__init__, undefined )

function dev_log( msg )
{
	if ( !( IS_TRUE( level.tod_dev ) || IS_TRUE( level.tod_diag ) || TOD_WS_LOG ) ) return;
	line = "[TOD_WS] ms=" + GetTime() + " " + msg;
	/#
	PrintLn( line );
	#/
}

function __init__()
{
	level.tod_ws_weapon = GetWeapon( TOD_WS_WEAPON );
	if ( !isdefined( level.tod_ws_weapon ) || level.tod_ws_weapon == level.weaponNone )
	{
		dev_log( "INIT_FAILED weapon=" + TOD_WS_WEAPON + " (not in the zone)" );
		return;
	}
	zm_powerups::register_powerup( TOD_WS_POWERUP, &grab );
	zm_powerups::register_powerup_weapon( TOD_WS_POWERUP, &countdown );
	zm_powerups::powerup_set_prevent_pick_up_if_drinking( TOD_WS_POWERUP, true );   // the Death Machine's rule: never mid-drink
	zm_powerups::set_weapon_ignore_max_ammo( TOD_WS_WEAPON );   // keyed by NAME (_zm_powerup_full_ammo reads weapon.name)
	// the trailing three: the timed tray row through stock's lane (Zombie Blood's contract, _tod_powerups.gsc)
	zm_powerups::add_zombie_powerup( TOD_WS_POWERUP, TOD_WS_PICKUP_MODEL, &"", &should_drop, POWERUP_ONLY_AFFECTS_GRABBER, !POWERUP_ANY_TEAM, !POWERUP_ZOMBIE_GRABBABLE, undefined, TOD_WS_POWERUP, TOD_WS_VAR_TIME, TOD_WS_VAR_ON );
	zm_powerups::powerup_set_can_pick_up_in_last_stand( TOD_WS_POWERUP, 0 );   // AFTER the add (its struct exists only then)
	zm_powerups::powerup_set_statless_powerup( TOD_WS_POWERUP );   // no pers stat for a custom name (v17.99)
	level.zombie_powerup_weapon[ TOD_WS_POWERUP ] = level.tod_ws_weapon;
	level._zombie_tesla_powerup_last_stand_func = &last_stand;
	callback::on_connect( &on_connect );
	zm_spawner::register_zombie_death_event_callback( &on_zombie_death );
	// a system __init__ runs inside zm_usermap::main, so this answers ahead of _tod_upgrades::upgrade_damage_cb
	// (registered by tod_main::init later): stock's chain takes the FIRST answer that is not -1
	zm::register_actor_damage_callback( &beam_damage_cb );
	level.tod_ws_kills_logged = 0;
	dev_log( "INIT weapon=" + TOD_WS_WEAPON + " drop_pct=" + TOD_WS_DROP_PCT + " secs=" + TOD_WS_SECS + " range=" + TOD_WS_RANGE
	       + " ticks horde=" + TOD_WS_HORDE_TICKS + " elite=" + TOD_WS_ELITE_TICKS + " boss=" + TOD_WS_BOSS_TICKS );
}

function on_connect()   // self = player
{
	if ( !isdefined( self.zombie_vars ) ) self.zombie_vars = [];
	self.zombie_vars[ TOD_WS_VAR_ON ] = false;
	self.zombie_vars[ TOD_WS_VAR_TIME ] = 0;
}

// =============================================================================
// THE DROP
// =============================================================================
function should_drop()
{
	blocked = ( zm_powerups::minigun_no_drop() || anyone_holds() );
	roll = RandomInt( 100 );
	ok = drop_gate( blocked, roll );
	if ( ok ) dev_log( "DROP_ROLL ok roll=" + roll );
	return ok;
}

// PURE. The shared slot's half: refused while a power-up gun is out or before the power
// (stock's rule), then TOD_WS_DROP_PCT of the rolls.
function drop_gate( blocked, roll )
{
	if ( IS_TRUE( blocked ) ) return false;
	return ( roll < TOD_WS_DROP_PCT );
}

function anyone_holds()
{
	foreach ( p in GetPlayers() )
		if ( p holds() ) return true;
	return false;
}

function holds()   // self = player
{
	return ( isdefined( self.zombie_vars ) && IS_TRUE( self.zombie_vars[ TOD_WS_VAR_ON ] ) );
}

// =============================================================================
// THE WINDOW
// =============================================================================
// self = the drop; player = the toucher (consumed: no return value)
function grab( player )
{
	level thread grant( player );
}

function grant( player )
{
	player endon( "disconnect" );
	player endon( "death" );
	player endon( "player_downed" );
	// a second grab while the gun is out refills the window (stock's minigun rule)
	if ( player holds() && player HasWeapon( level.tod_ws_weapon ) )
	{
		if ( player.zombie_vars[ TOD_WS_VAR_TIME ] < TOD_WS_SECS ) player.zombie_vars[ TOD_WS_VAR_TIME ] = TOD_WS_SECS;
		dev_log( "REFILL player=" + player GetEntityNumber() );
		return;
	}
	// stock's prone guard: the power-up gun cannot be raised lying down
	stance_disabled = false;
	if ( player GetStance() == "prone" )
	{
		player AllowCrouch( false );
		player AllowProne( false );
		stance_disabled = true;
		while ( player GetStance() != "stand" )
			WAIT_SERVER_FRAME;
	}
	player PlayLocalSound( "tod_ws_grab" );
	zm_powerups::weapon_powerup( player, TOD_WS_SECS, TOD_WS_POWERUP, true );
	if ( stance_disabled )
	{
		player AllowCrouch( true );
		player AllowProne( true );
	}
	dev_log( "GRANT player=" + player GetEntityNumber() + " secs=" + TOD_WS_SECS + " before=" + weapon_name( player._zombie_weapon_before_powerup[ TOD_WS_POWERUP ] ) );
	player thread beam_loop();
	player thread idle_hum();
}

// stock weapon_powerup_countdown calls this; it removes the gun when this returns
function countdown( player, str_time )
{
	was_paused = false;
	while ( player.zombie_vars[ str_time ] > 0 )
	{
		WAIT_SERVER_FRAME;
		player._show_solo_hud = true;   // keep-alive: Zombie Blood's / the Gift's end writes it false
		frozen = paused_for( level.tod_upgrade_pause, player.tod_menu_frozen, player.tod_spin_locked );
		if ( frozen != was_paused )
		{
			dev_log( "PAUSE player=" + player GetEntityNumber() + " on=" + frozen + " left=" + player.zombie_vars[ str_time ] );
			was_paused = frozen;
		}
		if ( !frozen )
			player.zombie_vars[ str_time ] = player.zombie_vars[ str_time ] - 0.05;
	}
	player PlayLocalSound( "tod_ws_expire" );
	dev_log( "END reason=timer player=" + player GetEntityNumber() );
}

// PURE. The window stands still while the world (a card deal) or the holder (a menu, a spin) is frozen.
function paused_for( world_paused, menu_frozen, spin_locked )
{
	return ( IS_TRUE( world_paused ) || IS_TRUE( menu_frozen ) || IS_TRUE( spin_locked ) );
}

// stock _zm.gsc threads this on every down (self = the player)
function last_stand()
{
	if ( !( self holds() ) ) return;
	dev_log( "LASTSTAND player=" + self GetEntityNumber() + " left=" + self.zombie_vars[ TOD_WS_VAR_TIME ] );
	zm_powerups::weapon_watch_gunner_downed( TOD_WS_POWERUP );
	self notify( "tod_ws_end" );
}

// the held-gun hum, on a carrier so it never fights another loop on the player
function idle_hum()   // self = player
{
	self endon( "disconnect" );
	carrier = Spawn( "script_origin", self.origin );
	if ( !isdefined( carrier ) ) return;
	carrier LinkTo( self );
	carrier PlayLoopSound( "tod_ws_idle_loop" );
	self util::waittill_any( "tod_ws_end", "death", "player_downed", "bled_out" );
	if ( isdefined( carrier ) )
	{
		carrier StopLoopSound();
		carrier Delete();
	}
}

// =============================================================================
// THE BEAM'S DAMAGE
// =============================================================================
function beam_loop()   // self = player
{
	self notify( "tod_ws_beam_loop" );
	self endon( "tod_ws_beam_loop" );
	self endon( "disconnect" );
	level endon( "end_game" );
	self.tod_ws_seen_isfiring = false;
	attack_ticks = 0;
	on = false;
	lane = "";
	t0 = 0;
	while ( self holds() )
	{
		isfiring = self IsFiring();
		gun_up = ( self GetCurrentWeapon() == level.tod_ws_weapon );
		attack = ( gun_up && self AttackButtonPressed() && !self IsSwitchingWeapons() && !self IsMeleeing() && !self IsSprinting() );
		if ( attack && !isfiring ) attack_ticks++;
		else attack_ticks = 0;
		if ( isfiring && !IS_TRUE( self.tod_ws_seen_isfiring ) ) self.tod_ws_seen_isfiring = true;
		now_lane = beam_lane( gun_up, isfiring, attack, IS_TRUE( self.tod_ws_seen_isfiring ), attack_ticks );
		if ( now_lane == "attack" && attack_ticks == TOD_WS_FALLBACK_TICKS )
			dev_log( "FALLBACK player=" + self GetEntityNumber() + " IsFiring has not reported this window; the trigger drives the damage" );
		allowed = ( !IS_TRUE( level.tod_upgrade_pause ) && !IS_TRUE( self.tod_jumppad_flying ) && !( self laststand::player_is_in_laststand() ) );
		want = ( now_lane != "" && allowed );
		if ( want && !on )
		{
			on = true;
			lane = now_lane;
			t0 = GetTime();
			self.tod_ws_b_ticks = 0;
			self.tod_ws_b_hits = 0;
			self.tod_ws_b_kills = 0;
			dev_log( "FIRE_ON player=" + self GetEntityNumber() + " lane=" + lane + " left=" + self.zombie_vars[ TOD_WS_VAR_TIME ] );
		}
		else if ( !want && on )
		{
			on = false;
			self fire_off_log( t0, lane );
		}
		if ( on ) self beam_tick( reach_at( GetTime() - t0 ) );
		wait TOD_WS_TICK;
	}
	if ( on ) self fire_off_log( t0, lane );
	self notify( "tod_ws_end" );
	dev_log( "END reason=window_closed player=" + self GetEntityNumber() );
}

function fire_off_log( t0, lane )   // self = player
{
	dev_log( "FIRE_OFF player=" + self GetEntityNumber() + " lane=" + lane + " ms=" + ( GetTime() - t0 ) + " ticks=" + self.tod_ws_b_ticks
	       + " hits=" + self.tod_ws_b_hits + " kills=" + self.tod_ws_b_kills );
}

// PURE. Which lane says the beam is on: the engine's IsFiring; the trigger only after
// IsFiring has never reported this window and the trigger has been held a moment with the
// gun up (a gas weapon whose IsFiring stays false would otherwise do nothing at all).
function beam_lane( gun_up, isfiring, attack, seen_isfiring, attack_ticks )
{
	if ( !IS_TRUE( gun_up ) ) return "";
	if ( IS_TRUE( isfiring ) ) return "isfiring";
	if ( IS_TRUE( attack ) && !IS_TRUE( seen_isfiring ) && attack_ticks >= TOD_WS_FALLBACK_TICKS ) return "attack";
	return "";
}

// PURE. How far the beam has reached ms into a burst: it shoots out at the beam asset's launch speed
// (a far zombie burns when the visible beam gets there), never past the range, never zero.
function reach_at( ms )
{
	if ( !isdefined( ms ) || ms < 0 ) ms = 0;
	r = TOD_WS_LAUNCH_SPEED * ( ms + TOD_WS_TICK * 1000 ) / 1000.0;   // the tick in flight counts
	if ( r > TOD_WS_RANGE ) r = TOD_WS_RANGE;
	return r;
}

function beam_tick( reach )   // self = player
{
	self.tod_ws_b_ticks++;
	eye = self GetEye();
	fwd = AnglesToForward( self GetPlayerAngles() );
	far = eye + fwd * reach;
	tr = BulletTrace( eye, far, false, self );
	stop = far;
	if ( isdefined( tr ) && isdefined( tr[ "position" ] ) ) stop = tr[ "position" ];
	team = ( isdefined( level.zombie_team ) ? level.zombie_team : "axis" );
	ais = GetAITeamArray( team );
	foreach ( z in ais )
	{
		if ( !isdefined( z ) || !IsAlive( z ) || IS_TRUE( z.tod_is_partner ) ) continue;
		kind = victim_kind( z.tod_boss_kind, z.archetype, IS_TRUE( z.is_boss ) || IS_TRUE( z.acc_is_boss ) || IS_TRUE( z.acc_is_mini_boss ) );
		bottom = z.origin + ( 0, 0, 6 );
		top = z.origin + ( 0, 0, kind_height( kind ) );
		if ( !beam_touches( eye, stop, fwd, bottom, top, kind_radius( kind ) ) ) continue;
		self hit( z, kind, fwd );
	}
}

function hit( z, kind, fwd )   // self = the holder
{
	dmult = ( isdefined( level.tod_dmg_mult ) ? level.tod_dmg_mult : 1 );   // the Insta-Kill window (_tod_powerups)
	hp = ( isdefined( z.maxhealth ) ? z.maxhealth : z.health );
	dmg = tick_damage_for( hp, kind, IS_TRUE( level.tod_rampage_on ), tod_zombie_speed::rampage_horde_mult(), tod_bosses::rampage_hp_mult(), dmult );
	now = GetTime();
	if ( !isdefined( z.tod_ws_fx_ms ) || now - z.tod_ws_fx_ms >= TOD_WS_FX_GAP_MS )
	{
		z.tod_ws_fx_ms = now;
		if ( self fx_budget( now ) )
		{
			fx_at( TOD_WS_FX_BURN, z.origin + ( 0, 0, kind_height( kind ) * 0.6 ), TOD_WS_BURN_LIFE );
			z PlaySound( "tod_ws_hit" );
		}
	}
	z.tod_ws_dir = fwd;
	self.tod_ws_b_hits++;
	z DoDamage( dmg, z.origin + ( 0, 0, 40 ), self, self, "none", "MOD_UNKNOWN", 0, level.tod_ws_weapon );
}

// The actor-damage chain (self = the actor hit). A HORDE tick is already final - a round-independent fraction of max
// health with Insta-Kill in it - so it is answered here, unchanged, before upgrade_damage_cb could multiply it a second
// time. Elites and the Dealer answer -1: their own lanes (armour, phases, weak points) and the cards still run.
// No free damage on a frozen horde (the Gift of Death's rule, _tod_powerups xmas_fixed_shots_cb).
function beam_damage_cb( inflictor, attacker, damage, flags, meansofdeath, weapon, vpoint, vdir, sHitLoc, psOffsetTime, boneIndex, surfaceType )
{
	if ( !isdefined( weapon ) || !isdefined( level.tod_ws_weapon ) || weapon != level.tod_ws_weapon ) return -1;
	if ( victim_kind( self.tod_boss_kind, self.archetype, IS_TRUE( self.is_boss ) || IS_TRUE( self.acc_is_boss ) || IS_TRUE( self.acc_is_mini_boss ) ) != "horde" ) return -1;
	if ( IS_TRUE( level.tod_upgrade_pause ) ) return 0;
	if ( !isdefined( damage ) || damage <= 0 ) return -1;
	return damage;
}

// TOD_WS_FX_PER_SEC sizzles a second per holder, however many bodies the beam crosses
function fx_budget( now )   // self = the holder
{
	if ( !isdefined( self.tod_ws_fx_t0 ) || now - self.tod_ws_fx_t0 >= 1000 )
	{
		self.tod_ws_fx_t0 = now;
		self.tod_ws_fx_n = 0;
	}
	if ( self.tod_ws_fx_n >= TOD_WS_FX_PER_SEC ) return false;
	self.tod_ws_fx_n++;
	return true;
}

// PURE. "boss" (the Dealer), "elite" (anything else flagged or not a plain zombie), "horde".
function victim_kind( boss_kind, archetype, boss_flag )
{
	if ( isdefined( boss_kind ) && boss_kind == "dealer" ) return "boss";
	if ( isdefined( boss_kind ) || IS_TRUE( boss_flag ) ) return "elite";
	if ( isdefined( archetype ) && archetype != "zombie" ) return "elite";
	return "horde";
}

function kind_radius( kind )
{
	if ( kind == "boss" ) return TOD_WS_R_BOSS;
	if ( kind == "elite" ) return TOD_WS_R_ELITE;
	return TOD_WS_R_HORDE;
}

function kind_height( kind )
{
	if ( kind == "boss" ) return TOD_WS_H_BOSS;
	if ( kind == "elite" ) return TOD_WS_H_ELITE;
	return TOD_WS_H_HORDE;
}

// PURE. Contact ticks that kill one from full; rampage (the hard mode) stretches them by its HP levers.
function ticks_for( kind, rampage, horde_mult, hp_mult )
{
	if ( kind == "boss" ) n = TOD_WS_BOSS_TICKS;
	else if ( kind == "elite" ) n = TOD_WS_ELITE_TICKS;
	else n = TOD_WS_HORDE_TICKS;
	if ( IS_TRUE( rampage ) )
	{
		if ( kind == "horde" ) n = n * horde_mult;
		else n = n * hp_mult;
	}
	return n;
}

// PURE. One tick's damage, already in the map's units (a fraction of max health; the power scale exempts it).
function tick_damage_for( hp, kind, rampage, horde_mult, hp_mult, dmult )
{
	if ( !isdefined( hp ) || hp < 1 ) hp = 1;
	dmg = hp / ticks_for( kind, rampage, horde_mult, hp_mult );
	if ( kind == "horde" && isdefined( dmult ) && dmult > 1 ) dmg = dmg * dmult;
	return int( dmg ) + 1;
}

// PURE. Does the beam (eye -> stop, heading fwd) come within r of the body's upright segment
// (bottom -> top), at a point in front of the eye?
function beam_touches( eye, stop, fwd, bottom, top, r )
{
	mid = ( ( bottom[ 0 ] + top[ 0 ] ) * 0.5, ( bottom[ 1 ] + top[ 1 ] ) * 0.5, ( bottom[ 2 ] + top[ 2 ] ) * 0.5 );
	ahead = ( mid[ 0 ] - eye[ 0 ] ) * fwd[ 0 ] + ( mid[ 1 ] - eye[ 1 ] ) * fwd[ 1 ] + ( mid[ 2 ] - eye[ 2 ] ) * fwd[ 2 ];
	if ( ahead <= 0 ) return false;
	return ( seg_seg_dist2( eye, stop, bottom, top ) <= r * r );
}

function dot3( a, b )
{
	return a[ 0 ] * b[ 0 ] + a[ 1 ] * b[ 1 ] + a[ 2 ] * b[ 2 ];
}

function clamp01( x )
{
	if ( x < 0 ) return 0;
	if ( x > 1 ) return 1;
	return x;
}

// PURE. The squared distance between segments p1-q1 and p2-q2 (Ericson, Real-Time Collision
// Detection 5.1.9), degenerate segments included.
function seg_seg_dist2( p1, q1, p2, q2 )
{
	d1 = ( q1[ 0 ] - p1[ 0 ], q1[ 1 ] - p1[ 1 ], q1[ 2 ] - p1[ 2 ] );
	d2 = ( q2[ 0 ] - p2[ 0 ], q2[ 1 ] - p2[ 1 ], q2[ 2 ] - p2[ 2 ] );
	rr = ( p1[ 0 ] - p2[ 0 ], p1[ 1 ] - p2[ 1 ], p1[ 2 ] - p2[ 2 ] );
	a = dot3( d1, d1 );
	e = dot3( d2, d2 );
	f = dot3( d2, rr );
	s = 0;
	t = 0;
	if ( a <= 0.0001 && e <= 0.0001 )
	{
		s = 0;
		t = 0;
	}
	else if ( a <= 0.0001 )
	{
		s = 0;
		t = clamp01( f / e );
	}
	else
	{
		c = dot3( d1, rr );
		if ( e <= 0.0001 )
		{
			t = 0;
			s = clamp01( 0 - c / a );
		}
		else
		{
			b = dot3( d1, d2 );
			denom = a * e - b * b;
			if ( denom > 0.0001 ) s = clamp01( ( b * f - c * e ) / denom );
			else s = 0;
			t = ( b * s + f ) / e;
			if ( t < 0 )
			{
				t = 0;
				s = clamp01( 0 - c / a );
			}
			else if ( t > 1 )
			{
				t = 1;
				s = clamp01( ( b - c ) / a );
			}
		}
	}
	c1 = ( p1[ 0 ] + d1[ 0 ] * s, p1[ 1 ] + d1[ 1 ] * s, p1[ 2 ] + d1[ 2 ] * s );
	c2 = ( p2[ 0 ] + d2[ 0 ] * t, p2[ 1 ] + d2[ 1 ] * t, p2[ 2 ] + d2[ 2 ] * t );
	dd = ( c1[ 0 ] - c2[ 0 ], c1[ 1 ] - c2[ 1 ], c1[ 2 ] - c2[ 2 ] );
	return dot3( dd, dd );
}

// =============================================================================
// THE KILL
// =============================================================================
// stock zombie death event (self = the zombie). Horde only: elites own their deaths.
function on_zombie_death( attacker )
{
	if ( !isdefined( self ) || !isdefined( level.tod_ws_weapon ) ) return;
	if ( !isdefined( self.damageweapon ) || self.damageweapon != level.tod_ws_weapon ) return;
	kind = victim_kind( self.tod_boss_kind, self.archetype, IS_TRUE( self.is_boss ) || IS_TRUE( self.acc_is_boss ) || IS_TRUE( self.acc_is_mini_boss ) );
	if ( kind != "horde" ) return;
	burst = "lit";
	if ( isdefined( attacker ) && IsPlayer( attacker ) ) burst = attacker kill_fx_budget( GetTime() );
	if ( burst == "lit" ) fx_at( TOD_WS_FX_DIE, self.origin + ( 0, 0, 44 ), TOD_WS_DIE_LIFE );
	else if ( burst == "nl" ) fx_at( TOD_WS_FX_DIE_NL, self.origin + ( 0, 0, 44 ), TOD_WS_DIE_LIFE );
	self PlaySound( "tod_ws_kill" );   // the alias carries its own voice limit
	if ( isdefined( attacker ) && IsPlayer( attacker ) && isdefined( attacker.tod_ws_b_kills ) ) attacker.tod_ws_b_kills++;
	flung = false;
	if ( !IS_TRUE( self.tod_bat_launched ) && !( isdefined( level.ragdoll_limit_check ) && ![[ level.ragdoll_limit_check ]]() ) )
	{
		dir = ( 1, 0, 0 );
		if ( isdefined( self.tod_ws_dir ) ) dir = self.tod_ws_dir;
		flat = ( dir[ 0 ], dir[ 1 ], 0 );
		if ( Length( flat ) > 0.01 ) flat = VectorNormalize( flat );
		else flat = ( 1, 0, 0 );
		impulse = flat * RandomIntRange( 90, 130 ) + ( 0, 0, RandomIntRange( 40, 80 ) );
		self.tod_bat_launched = true;   // the shared once-per-body mark (the bat's)
		self StartRagdoll();
		self LaunchRagdoll( impulse );
		flung = true;
	}
	if ( level.tod_ws_kills_logged < TOD_WS_LOG_KILLS )
	{
		level.tod_ws_kills_logged++;
		dev_log( "KILL ent=" + self GetEntityNumber() + " by=" + ( ( isdefined( attacker ) && IsPlayer( attacker ) ) ? attacker GetEntityNumber() : -1 ) + " burst=" + burst + " flung=" + flung + " round=" + level.round_number );
	}
}

// the holder's kill-burst budget this second (self = the holder): "lit", "nl" or "" (the sound alone)
function kill_fx_budget( now )
{
	if ( !isdefined( self.tod_ws_kfx_t0 ) || now - self.tod_ws_kfx_t0 >= 1000 )
	{
		self.tod_ws_kfx_t0 = now;
		self.tod_ws_kfx_lit = 0;
		self.tod_ws_kfx_nl = 0;
	}
	pick = kill_fx_pick( self.tod_ws_kfx_lit, self.tod_ws_kfx_nl );
	if ( pick == "lit" ) self.tod_ws_kfx_lit++;
	else if ( pick == "nl" ) self.tod_ws_kfx_nl++;
	return pick;
}

// PURE. A streak's bursts: the lit one first, then the unlit one, then none (a line of twenty kills in a beat
// would otherwise put twenty lights and ~1000 particles up at once).
function kill_fx_pick( lit_n, nl_n )
{
	if ( !isdefined( lit_n ) ) lit_n = 0;
	if ( !isdefined( nl_n ) ) nl_n = 0;
	if ( lit_n < TOD_WS_KILL_LIT_PER_SEC ) return "lit";
	if ( nl_n < TOD_WS_KILL_NL_PER_SEC ) return "nl";
	return "";
}

// A world effect on its own tag_origin carrier (CLAUDE.md "Server FX": PlayFXOnTag on a carrier, two frames to
// replicate first, the host deletes itself). The kill effects are authored as loops that land one round inside the
// carrier's life (tools/wunderstrahl/fx: a server one-shot renders nothing), so the deletion is what ends them.
function fx_at( fx, org, life )
{
	host = Spawn( "script_model", org );
	if ( !isdefined( host ) )
	{
		dev_log( "FX_DROPPED fx=" + fx + " reason=entity_pool_full" );
		return;
	}
	host SetModel( "tag_origin" );
	host thread fx_host_run( fx, life );
}

function fx_host_run( fx, life )   // self = the carrier
{
	self endon( "death" );
	wait TOD_WS_FX_HOST_WAIT;
	PlayFXOnTag( fx, self, "tag_origin" );
	wait life;
	if ( isdefined( self ) ) self Delete();
}

function weapon_name( w )
{
	if ( !isdefined( w ) || !isdefined( w.name ) ) return "none";
	return w.name;
}
