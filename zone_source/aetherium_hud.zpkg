// AETHERIUM WIDGETS
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/AetheriumLoadout.lua
// GENERATED by tools/slice_hud_sheets.js. AetheriumLoadout.lua require()s this
// for the custom typeface's advance widths, so a missing rawfile line here is a
// SILENT runtime failure of the whole gun HUD, not a missing number.
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/TodGlyphMetrics.lua
// v17.25 — the pooled glyph ROW that consumes those metrics. Lifted out of
// AetheriumLoadout.lua when the top-right ROUND readout became the second
// widget to set text in the baked typeface. Same silent-failure warning as the
// line above, now doubled: without this line BOTH the gun HUD and the round
// counter die on the require, and neither prints anything at build time.
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/TodGlyphRow.lua
// v17.34 — the UIText-shaped element built on that row, so a readout can be
// converted to the baked typeface by swapping its constructor. Required by the
// player panel, the party rows, the +points popup and the kill feed: without
// this line the WHOLE LEFT COLUMN and the kill feed die on the require, and
// nothing prints at build time. Same silent-failure family as the two above.
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/TodGlyphText.lua
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/TodHealthTint.lua
rawfile,ui/uieditor/widgets/HUD/AetheriumWidgets/AetheriumPlayerInfo.lua
